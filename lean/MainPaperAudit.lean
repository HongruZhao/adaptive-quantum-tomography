      let axioms ← Lean.collectAxioms n
      logInfo m!"PAPER_AXIOM_RECEIPT {n} {axioms.toList}"
      let unsupported := axioms.filter fun a =>
        a != `propext && a != `Classical.choice && a != `Quot.sound
      unless unsupported.isEmpty do
        throwError m!"UNSUPPORTED_PAPER_AXIOM {n} {unsupported.toList}"
  logInfo m!"PAPER_STATEMENT_TOTAL {names.size}"

#audit_main_paper
