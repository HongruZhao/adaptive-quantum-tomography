import Mathlib.Analysis.InnerProductSpace.Positive
import QubitOracle.FiniteGillMassar
import QubitOracle.Paper.MixedOracleGeometry
import QubitOracle.Paper.QubitFoundations
/-!
# Feasible normalized information region

The normalized information matrices generated by randomized projective axes
are exactly the positive-semidefinite matrices of trace one.  The converse is
proved from Mathlib's finite-dimensional rank-one decomposition theorem and
does not assume a spectral decomposition as a new axiom.
-/

namespace QubitOracle.Paper

open scoped BigOperators

noncomputable section

/-- A finite convex mixture of unit Bloch rank-one projectors. -/
def IsNormalizedProjectiveInformation (A : OracleMatrix) : Prop :=
  ∃ (m : ℕ) (w : Fin m -> ℝ) (x : Fin m -> Fin 3 -> ℝ),
    (∀ i, 0 ≤ w i) ∧
      (∀ i, blochNormSq (x i) = 1) ∧
      (∑ i, w i) = 1 ∧
      A = ∑ i, w i • blochOuter (x i)

theorem blochNormSq_nonneg (v : Fin 3 -> ℝ) :
    0 ≤ blochNormSq v := by
  simp [blochNormSq, Fin.sum_univ_succ]
  positivity

theorem blochNormSq_eq_zero_iff (v : Fin 3 -> ℝ) :
    blochNormSq v = 0 ↔ v = 0 := by
  constructor
  · intro h
    funext i
    fin_cases i <;>
      simp [blochNormSq, Fin.sum_univ_succ] at h ⊢ <;>
      nlinarith [sq_nonneg (v 0), sq_nonneg (v 1), sq_nonneg (v 2)]
  · rintro rfl
    simp [blochNormSq]

theorem trace_blochOuter (v : Fin 3 -> ℝ) :
    Matrix.trace (blochOuter v) = blochNormSq v := by
  simp [Matrix.trace, blochOuter, blochNormSq, Fin.sum_univ_succ]
  ring

/-- Squared norm used as the convex weight of a rank-one summand. -/
def normalizedMixtureWeight (v : Fin 3 -> ℝ) : ℝ :=
  blochNormSq v

/-- Unit direction of a rank-one summand, with an arbitrary fixed direction
for the zero summand. -/
def normalizedMixtureAxis (v : Fin 3 -> ℝ) : Fin 3 -> ℝ :=
  if blochNormSq v = 0 then standardBasis3 0 else oracleNormalize v

theorem normalizedMixtureAxis_normSq (v : Fin 3 -> ℝ) :
    blochNormSq (normalizedMixtureAxis v) = 1 := by
  by_cases h : blochNormSq v = 0
  · rw [normalizedMixtureAxis, if_pos h]
    simp [standardBasis3, blochNormSq, Fin.sum_univ_succ]
  · have hv : 0 < blochNormSq v :=
      lt_of_le_of_ne (blochNormSq_nonneg v) (Ne.symm h)
    simpa [normalizedMixtureAxis, h] using
      oracleNormalize_normSq_eq_one v hv

theorem normalizedMixtureWeight_smul_outer (v : Fin 3 -> ℝ) :
    normalizedMixtureWeight v • blochOuter (normalizedMixtureAxis v) =
      Matrix.vecMulVec v v := by
  by_cases h : blochNormSq v = 0
  · have hv0 : v = 0 := (blochNormSq_eq_zero_iff v).1 h
    subst v
    simp [normalizedMixtureWeight, normalizedMixtureAxis,
      blochNormSq, blochOuter]
  · have hv : 0 < blochNormSq v :=
      lt_of_le_of_ne (blochNormSq_nonneg v) (Ne.symm h)
    rw [normalizedMixtureAxis]
    simp only [h, if_false]
    rw [blochOuter_oracleNormalize_eq_normalizedOuter v hv]
    unfold normalizedMixtureWeight oracleNormalizedOuter
    rw [smul_smul]
    simp [h, Matrix.vecMulVec]
    ext i j
    rfl

/-- Exact normalized information-region characterization. -/
theorem normalized_projective_information_iff
    (A : OracleMatrix) :
    IsNormalizedProjectiveInformation A ↔
      A.PosSemidef ∧ Matrix.trace A = 1 := by
  constructor
  · rintro ⟨m, w, x, hw, hx, hsum, hA⟩
    constructor
    · apply (Matrix.posSemidef_iff_eq_sum_vecMulVec).2
      refine ⟨m, fun i => Real.sqrt (w i) • x i, ?_⟩
      rw [hA]
      apply Finset.sum_congr rfl
      intro i _
      ext p q
      simp [blochOuter, Matrix.vecMulVec]
      calc
        w i * (x i p * x i q) =
            Real.sqrt (w i) ^ 2 * (x i p * x i q) := by
              rw [Real.sq_sqrt (hw i)]
        _ = Real.sqrt (w i) * x i p * (Real.sqrt (w i) * x i q) := by
              ring
    · calc
        Matrix.trace A =
            ∑ i, Matrix.trace (w i • blochOuter (x i)) := by
              rw [hA]
              exact Matrix.trace_sum Finset.univ _
        _ = ∑ i, w i := by
              apply Finset.sum_congr rfl
              intro i _
              simp [trace_blochOuter, hx i]
        _ = 1 := hsum
  · rintro ⟨hpos, htrace⟩
    obtain ⟨m, v, hA⟩ :=
      (Matrix.posSemidef_iff_eq_sum_vecMulVec).1 hpos
    refine ⟨m, fun i => normalizedMixtureWeight (v i),
      fun i => normalizedMixtureAxis (v i), ?_, ?_, ?_, ?_⟩
    · intro i
      exact blochNormSq_nonneg (v i)
    · intro i
      exact normalizedMixtureAxis_normSq (v i)
    · calc
        (∑ i, normalizedMixtureWeight (v i)) = Matrix.trace A := by
          rw [hA, Matrix.trace_sum]
          apply Finset.sum_congr rfl
          intro i _
          simp [normalizedMixtureWeight, Matrix.trace_vecMulVec,
            blochNormSq, dotProduct, Fin.sum_univ_succ]
          ring
        _ = 1 := htrace
    · rw [hA]
      apply Finset.sum_congr rfl
      intro i _
      simpa using (normalizedMixtureWeight_smul_outer (v i)).symm

end

end QubitOracle.Paper
