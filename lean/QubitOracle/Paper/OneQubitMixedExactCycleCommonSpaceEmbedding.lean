import QubitOracle.Paper.OneQubitMixedExactCycleMathlibCondExpClosed
import Mathlib.Probability.ConditionalExpectation
import Mathlib.Probability.Independence.InfinitePi

/-!
# A common probability space for the exact-cycle rows

For a sequence `A n` of concrete exact-cycle row data and a sequence
`rowSize n`, this file puts all rows on the dependent product

`CommonOmega A rowSize = forall n, (A n).RowSpace (rowSize n)`.

The common law is Mathlib's countable product `Measure.infinitePi`.  Its finite
coordinate restrictions are the finite products `Measure.pi`.  The augmented
filtration at row `n` reveals every complete row before `n`, together with the
pilot and current final prefix in row `n`.

Hall and Heyde (1980), Corollary 3.1, condition (3.21), asks for cross-row
nesting at a common within-row index.  The construction below proves the
stronger inclusion of every stage of row `n` in every stage of row `n + 1`.
The remark immediately following that corollary states that condition (3.21)
is not needed when the limiting variance is a constant.  Thus this nesting is
available, but it is not promoted to a necessary hypothesis for the present
deterministic target variance `sigmaSq`.

No Gaussian convergence theorem is stated.  The one isolated Mathlib API
boundary is transport of conditional expectation through a product coordinate
after adjoining the independent sigma algebra generated by earlier rows.
-/

open scoped BigOperators ENNReal
open Filter MeasureTheory

namespace QubitOracle.Paper
namespace MixedExactCycleScalarTriangularArrayData

/-- The row type used at coordinate `n` of the common product. -/
abbrev CommonRow
    (A : ℕ → MixedExactCycleScalarTriangularArrayData)
    (rowSize : ℕ → ℕ) (n : ℕ) :=
  (A n).RowSpace (rowSize n)

/-- The dependent countable product carrying all concrete finite rows. -/
abbrev CommonOmega
    (A : ℕ → MixedExactCycleScalarTriangularArrayData)
    (rowSize : ℕ → ℕ) :=
  ∀ n : ℕ, CommonRow A rowSize n

section CommonSpace

variable (A : ℕ → MixedExactCycleScalarTriangularArrayData)
variable (rowSize : ℕ → ℕ)

local instance rowMeasurableSpace (n : ℕ) :
    MeasurableSpace (CommonRow A rowSize n) := ⊤

local instance rowMeasurableSingletonClass (n : ℕ) :
    MeasurableSingletonClass (CommonRow A rowSize n) where
  measurableSet_singleton _ := MeasurableSet.of_discrete

/-- The exact probability measure of row `n`. -/
noncomputable def commonRowMeasure (n : ℕ) :
    Measure (CommonRow A rowSize n) :=
  (A n).mathlibRowMeasure (rowSize n)

noncomputable instance commonRowMeasure_isProbabilityMeasure (n : ℕ) :
    IsProbabilityMeasure (commonRowMeasure A rowSize n) := by
  change IsProbabilityMeasure ((A n).mathlibRowMeasure (rowSize n))
  infer_instance

/-- The common product probability measure. -/
noncomputable def commonMeasure : Measure (CommonOmega A rowSize) :=
  Measure.infinitePi fun n => commonRowMeasure A rowSize n

noncomputable instance commonMeasure_isProbabilityMeasure :
    IsProbabilityMeasure (commonMeasure A rowSize) := by
  unfold commonMeasure
  infer_instance

/-- Projection from the common sample point to row `n`. -/
def rowCoordinate (n : ℕ) :
    CommonOmega A rowSize → CommonRow A rowSize n :=
  fun omega => omega n

theorem rowCoordinate_measurable (n : ℕ) :
    Measurable (rowCoordinate A rowSize n) :=
  measurable_pi_apply n

/-- Each coordinate has exactly its original finite row law. -/
theorem commonMeasure_map_coordinate (n : ℕ) :
    (commonMeasure A rowSize).map (rowCoordinate A rowSize n) =
      commonRowMeasure A rowSize n := by
  change (Measure.infinitePi fun j => commonRowMeasure A rowSize j).map
      (fun omega : CommonOmega A rowSize => omega n) =
    commonRowMeasure A rowSize n
  exact Measure.infinitePi_map_eval
    (fun j => commonRowMeasure A rowSize j) n

/-- Coordinate projection is measure preserving. -/
theorem rowCoordinate_measurePreserving (n : ℕ) :
    MeasurePreserving (rowCoordinate A rowSize n)
      (commonMeasure A rowSize) (commonRowMeasure A rowSize n) := by
  change MeasurePreserving
    (fun omega : CommonOmega A rowSize => omega n)
    (Measure.infinitePi fun j => commonRowMeasure A rowSize j)
    (commonRowMeasure A rowSize n)
  exact measurePreserving_eval_infinitePi
    (fun j => commonRowMeasure A rowSize j) n

/-- Every finite collection of common-space coordinates has the finite
`Measure.pi` product law. -/
theorem commonMeasure_map_finiteRows (I : Finset ℕ) :
    (commonMeasure A rowSize).map I.restrict =
      Measure.pi (fun i : I => commonRowMeasure A rowSize i.1) := by
  simpa [commonMeasure] using
    (Measure.infinitePi_map_restrict
      (μ := fun n => commonRowMeasure A rowSize n) (I := I))

/-- The row-coordinate projections are mutually independent. -/
theorem rowCoordinates_iIndepFun :
    ProbabilityTheory.iIndepFun
      (fun n => rowCoordinate A rowSize n) (commonMeasure A rowSize) := by
  change ProbabilityTheory.iIndepFun
    (fun n (omega : CommonOmega A rowSize) => omega n)
    (Measure.infinitePi fun n => commonRowMeasure A rowSize n)
  exact ProbabilityTheory.iIndepFun_infinitePi
    (P := fun n => commonRowMeasure A rowSize n)
    (X := fun n (row : CommonRow A rowSize n) => row)
    (fun _n => measurable_id)

/-- Lift a row random variable to the common space by coordinate projection. -/
def liftRowVariable (n : ℕ) (f : CommonRow A rowSize n → ℝ) :
    CommonOmega A rowSize → ℝ :=
  fun omega => f (omega n)

/-! ## The augmented filtration -/

/-- Explicit monotonicity of measurable-space comap. -/
private theorem comap_mono_explicit
    {α β : Type*} (f : α → β)
    {m₁ m₂ : MeasurableSpace β} (hm : m₁ ≤ m₂) :
    MeasurableSpace.comap f m₁ ≤ MeasurableSpace.comap f m₂ := by
  intro s hs
  change ∃ u, MeasurableSet[m₁] u ∧ f ⁻¹' u = s at hs
  rcases hs with ⟨u, hu, rfl⟩
  exact ⟨u, hm _ hu, rfl⟩

/-- Sigma algebra revealing every complete row with index strictly below `n`. -/
def completeEarlierRowsSigma (n : ℕ) :
    MeasurableSpace (CommonOmega A rowSize) :=
  ⨆ j : Fin n,
    MeasurableSpace.comap
      (fun omega : CommonOmega A rowSize => omega j.1)
      (⊤ : MeasurableSpace (CommonRow A rowSize j.1))

/-- Pullback of the original row-`n` prefix sigma algebra. -/
def currentRowPrefixSigma (n k : ℕ) :
    MeasurableSpace (CommonOmega A rowSize) :=
  MeasurableSpace.comap (rowCoordinate A rowSize n)
    ((A n).rowFiltrationSigma (rowSize n) k)

/-- Earlier complete rows joined with the current row's pilot and final prefix. -/
def augmentedRowFiltrationSigma (n k : ℕ) :
    MeasurableSpace (CommonOmega A rowSize) :=
  completeEarlierRowsSigma A rowSize n ⊔
    currentRowPrefixSigma A rowSize n k

theorem completeEarlierRowsSigma_le (n : ℕ) :
    completeEarlierRowsSigma A rowSize n ≤
      (inferInstance : MeasurableSpace (CommonOmega A rowSize)) := by
  refine iSup_le fun j => ?_
  exact (measurable_pi_apply j.1).comap_le

theorem currentRowPrefixSigma_le (n k : ℕ) :
    currentRowPrefixSigma A rowSize n k ≤
      (inferInstance : MeasurableSpace (CommonOmega A rowSize)) := by
  calc
    currentRowPrefixSigma A rowSize n k ≤
        MeasurableSpace.comap (rowCoordinate A rowSize n)
          (⊤ : MeasurableSpace (CommonRow A rowSize n)) :=
      comap_mono_explicit _ le_top
    _ ≤ (inferInstance : MeasurableSpace (CommonOmega A rowSize)) :=
      (rowCoordinate_measurable A rowSize n).comap_le

theorem augmentedRowFiltrationSigma_le (n k : ℕ) :
    augmentedRowFiltrationSigma A rowSize n k ≤
      (inferInstance : MeasurableSpace (CommonOmega A rowSize)) := by
  exact sup_le (completeEarlierRowsSigma_le A rowSize n)
    (currentRowPrefixSigma_le A rowSize n k)

/-- Within each row the augmented sigma algebras are increasing. -/
theorem augmentedRowFiltrationSigma_mono (n : ℕ) :
    Monotone (augmentedRowFiltrationSigma A rowSize n) := by
  intro k ell hkell
  have hRow :
      (A n).rowFiltrationSigma (rowSize n) k ≤
        (A n).rowFiltrationSigma (rowSize n) ell := by
    simpa [rowFiltration] using
      (((A n).rowFiltration (rowSize n)).mono hkell)
  exact sup_le le_sup_left
    ((comap_mono_explicit _ hRow).trans le_sup_right)

/-- The augmented filtration as an actual Mathlib `Filtration`. -/
def augmentedRowFiltration (n : ℕ) :
    Filtration ℕ
      (inferInstance : MeasurableSpace (CommonOmega A rowSize)) where
  seq := augmentedRowFiltrationSigma A rowSize n
  mono' := augmentedRowFiltrationSigma_mono A rowSize n
  le' := augmentedRowFiltrationSigma_le A rowSize n

/-- Complete earlier-row information is monotone in the row index. -/
theorem completeEarlierRowsSigma_mono (n : ℕ) :
    completeEarlierRowsSigma A rowSize n ≤
      completeEarlierRowsSigma A rowSize (n + 1) := by
  refine iSup_le fun j => ?_
  refine le_iSup_of_le (Fin.castSucc j) ?_
  rfl

/-- Any current-row prefix is contained in the complete-row information at the
next row. -/
theorem currentRowPrefixSigma_le_nextEarlier (n k : ℕ) :
    currentRowPrefixSigma A rowSize n k ≤
      completeEarlierRowsSigma A rowSize (n + 1) := by
  calc
    currentRowPrefixSigma A rowSize n k ≤
        MeasurableSpace.comap (rowCoordinate A rowSize n)
          (⊤ : MeasurableSpace (CommonRow A rowSize n)) :=
      comap_mono_explicit _ le_top
    _ ≤ completeEarlierRowsSigma A rowSize (n + 1) := by
      refine le_iSup_of_le (Fin.last n) ?_
      rfl

/-- Strong cross-row nesting: every stage in row `n` is contained in every
stage in row `n + 1`. -/
theorem augmentedRowFiltrationSigma_crossRow
    (n k ell : ℕ) :
    augmentedRowFiltrationSigma A rowSize n k ≤
      augmentedRowFiltrationSigma A rowSize (n + 1) ell := by
  exact sup_le
    ((completeEarlierRowsSigma_mono A rowSize n).trans le_sup_left)
    ((currentRowPrefixSigma_le_nextEarlier A rowSize n k).trans le_sup_left)

/-- Hall-Heyde condition (3.21), restricted to within-row indices existing in
both varying finite rows. -/
def HallHeydeCondition321 : Prop :=
  ∀ n k : ℕ,
    k ≤ 3 * rowSize n →
    k ≤ 3 * rowSize (n + 1) →
      augmentedRowFiltrationSigma A rowSize n k ≤
        augmentedRowFiltrationSigma A rowSize (n + 1) k

theorem hallHeydeCondition321 :
    HallHeydeCondition321 A rowSize := by
  intro n k hk hknext
  exact augmentedRowFiltrationSigma_crossRow A rowSize n k k

/-! ## Lifted score variables and adaptedness -/

noncomputable def liftedScore (n : ℕ) (t : Fin (3 * rowSize n)) :
    CommonOmega A rowSize → ℝ :=
  liftRowVariable A rowSize n
    ((A n).currentCoordinateObservable (rowSize n) t
      ((A n).scoreObservable (rowSize n) t))

noncomputable def liftedSquaredScore (n : ℕ) (t : Fin (3 * rowSize n)) :
    CommonOmega A rowSize → ℝ :=
  liftRowVariable A rowSize n
    ((A n).currentCoordinateObservable (rowSize n) t
      ((A n).squaredScoreObservable (rowSize n) t))

noncomputable def liftedOneShotFisher (n : ℕ) (t : Fin (3 * rowSize n)) :
    CommonOmega A rowSize → ℝ :=
  liftRowVariable A rowSize n
    ((A n).oneShotFisherKernel (rowSize n) t)

noncomputable def liftedLindebergObservable (n : ℕ)
    (t : Fin (3 * rowSize n)) (epsilon : ℝ) :
    CommonOmega A rowSize → ℝ :=
  liftRowVariable A rowSize n
    ((A n).currentCoordinateObservable (rowSize n) t
      ((A n).lindebergObservable (rowSize n) t epsilon))

noncomputable def liftedOneShotLindebergKernel (n : ℕ)
    (t : Fin (3 * rowSize n)) (epsilon : ℝ) :
    CommonOmega A rowSize → ℝ :=
  liftRowVariable A rowSize n
    ((A n).oneShotLindebergKernel (rowSize n) t epsilon)

/-- A row-measurable function remains measurable after coordinate lifting and
after adjoining all earlier complete rows. -/
theorem liftRowVariable_measurable
    (n k : ℕ) (f : CommonRow A rowSize n → ℝ)
    (hf : Measurable[(A n).rowFiltrationSigma (rowSize n) k] f) :
    Measurable[augmentedRowFiltrationSigma A rowSize n k]
      (liftRowVariable A rowSize n f) := by
  have hCoordinate :
      @Measurable (CommonOmega A rowSize) (CommonRow A rowSize n)
        (currentRowPrefixSigma A rowSize n k)
        ((A n).rowFiltrationSigma (rowSize n) k)
        (rowCoordinate A rowSize n) := by
    rw [measurable_iff_comap_le]
    exact le_rfl
  have hSmall :
      Measurable[currentRowPrefixSigma A rowSize n k]
        (liftRowVariable A rowSize n f) := by
    exact hf.comp hCoordinate
  exact hSmall.mono le_sup_right le_rfl

/-- The lifted score at time `t` is adapted at time `t + 1`. -/
theorem liftedScore_measurable_succ
    (n : ℕ) (t : Fin (3 * rowSize n)) :
    Measurable[augmentedRowFiltrationSigma A rowSize n (t.1 + 1)]
      (liftedScore A rowSize n t) := by
  simpa [liftedScore, liftRowVariable] using
    liftRowVariable_measurable A rowSize n (t.1 + 1)
      ((A n).currentCoordinateObservable (rowSize n) t
        ((A n).scoreObservable (rowSize n) t))
      ((A n).rowScoreIncrement_measurable_succ (rowSize n) t)

/-! ## The exact conditional-expectation API boundary -/

/--
The sole common-space conditional-expectation API boundary.

Mathematically this is the standard product-coordinate identity: if `g` is a
version of the row conditional expectation of `f` given the current row prefix,
then `g` lifted through coordinate `n` is a version of the common-space
conditional expectation after adjoining the independent sigma algebra of all
earlier rows.  It follows from `rowCoordinates_iIndepFun`, finite-cylinder
factorization via `commonMeasure_map_finiteRows`, and conditional-expectation
uniqueness.  Mathlib does not expose this joined-sigma pullback as one theorem,
so its exact signature is isolated here rather than asserted as an axiom.
-/
structure CommonSpaceCondExpPullbackAPI : Prop where
  condExp_lift :
    ∀ (n k : ℕ) (f g : CommonRow A rowSize n → ℝ),
      ((A n).mathlibRowMeasure (rowSize n))[
          f | (A n).rowFiltrationSigma (rowSize n) k] =ᵐ[
            (A n).mathlibRowMeasure (rowSize n)] g →
        (commonMeasure A rowSize)[
            liftRowVariable A rowSize n f |
            augmentedRowFiltrationSigma A rowSize n k] =ᵐ[
              commonMeasure A rowSize]
          liftRowVariable A rowSize n g

/-- Lifted conditional score centering, relative only to the named Mathlib API
transport above. -/
theorem liftedScore_condExp_zero
    (hAPI : CommonSpaceCondExpPullbackAPI A rowSize)
    (n : ℕ) (t : Fin (3 * rowSize n)) :
    (commonMeasure A rowSize)[
        liftedScore A rowSize n t |
        augmentedRowFiltrationSigma A rowSize n t.1] =ᵐ[
          commonMeasure A rowSize]
      (fun _ : CommonOmega A rowSize => (0 : ℝ)) := by
  change (commonMeasure A rowSize)[
      liftRowVariable A rowSize n
        ((A n).currentCoordinateObservable (rowSize n) t
          ((A n).scoreObservable (rowSize n) t)) |
      augmentedRowFiltrationSigma A rowSize n t.1] =ᵐ[
        commonMeasure A rowSize]
      liftRowVariable A rowSize n (fun _ => 0)
  exact hAPI.condExp_lift n t.1
      ((A n).currentCoordinateObservable (rowSize n) t
        ((A n).scoreObservable (rowSize n) t))
      (fun _ => 0)
      ((A n).scoreIncrement_literal_condExp_zero (rowSize n) t)

/-- Lifted conditional squared-score identity. -/
theorem liftedSquaredScore_condExp_eq_oneShotFisher
    (hAPI : CommonSpaceCondExpPullbackAPI A rowSize)
    (n : ℕ) (hrowSize : 0 < rowSize n)
    (t : Fin (3 * rowSize n)) :
    (commonMeasure A rowSize)[
        liftedSquaredScore A rowSize n t |
        augmentedRowFiltrationSigma A rowSize n t.1] =ᵐ[
          commonMeasure A rowSize]
      liftedOneShotFisher A rowSize n t := by
  simpa [liftedSquaredScore, liftedOneShotFisher] using
    hAPI.condExp_lift n t.1
      ((A n).currentCoordinateObservable (rowSize n) t
        ((A n).squaredScoreObservable (rowSize n) t))
      ((A n).oneShotFisherKernel (rowSize n) t)
      ((A n).squaredScore_literal_condExp_eq_oneShotFisher
        (rowSize n) hrowSize t)

/-- Lifted conditional Lindeberg identity. -/
theorem liftedLindeberg_condExp_eq_kernel
    (hAPI : CommonSpaceCondExpPullbackAPI A rowSize)
    (n : ℕ) (t : Fin (3 * rowSize n)) (epsilon : ℝ) :
    (commonMeasure A rowSize)[
        liftedLindebergObservable A rowSize n t epsilon |
        augmentedRowFiltrationSigma A rowSize n t.1] =ᵐ[
          commonMeasure A rowSize]
      liftedOneShotLindebergKernel A rowSize n t epsilon := by
  simpa [liftedLindebergObservable, liftedOneShotLindebergKernel] using
    hAPI.condExp_lift n t.1
      ((A n).currentCoordinateObservable (rowSize n) t
        ((A n).lindebergObservable (rowSize n) t epsilon))
      ((A n).oneShotLindebergKernel (rowSize n) t epsilon)
      ((A n).lindebergObservable_literal_condExp_eq_kernel
        (rowSize n) t epsilon)

/-! ## Lifted predictable quantities -/

noncomputable def liftedPredictableQuadraticVariation (n : ℕ) :
    CommonOmega A rowSize → ℝ :=
  liftRowVariable A rowSize n
    ((A n).predictableQuadraticVariation (rowSize n))

noncomputable def liftedExplicitNormalizedFisher (n : ℕ) :
    CommonOmega A rowSize → ℝ :=
  liftRowVariable A rowSize n
    (fun row => (A n).explicitNormalizedFisher (rowSize n) row.1)

theorem liftedPredictableQuadraticVariation_eq_explicitFisher
    (n : ℕ) :
    liftedPredictableQuadraticVariation A rowSize n =
      liftedExplicitNormalizedFisher A rowSize n := by
  funext omega
  exact (A n).predictableQuadraticVariation_eq_explicitNormalizedFisher
    (rowSize n) (omega n)

noncomputable def liftedPredictableLindebergExpression
    (n : ℕ) (epsilon : ℝ) : CommonOmega A rowSize → ℝ :=
  liftRowVariable A rowSize n
    ((A n).predictableLindebergExpression (rowSize n) epsilon)

noncomputable def liftedConditionalLindebergSum
    (n : ℕ) (epsilon : ℝ) : CommonOmega A rowSize → ℝ :=
  liftRowVariable A rowSize n
    (fun row => (A n).conditionalLindebergSum
      (rowSize n) row.1 epsilon)

theorem liftedPredictableLindebergExpression_eq_sum
    (n : ℕ) (epsilon : ℝ) :
    liftedPredictableLindebergExpression A rowSize n epsilon =
      liftedConditionalLindebergSum A rowSize n epsilon := by
  funext omega
  exact (A n).predictableLindebergExpression_eq_conditionalLindebergSum
    (rowSize n) epsilon (omega n)

/-! ## Equivalence of row-specific and common-space convergence -/

/-- A varying-row, varying-space definition of convergence in probability to
a scalar target. -/
def RowConvergesInProbabilityTo
    (Z : ∀ n, CommonRow A rowSize n → ℝ) (target : ℝ) : Prop :=
  ∀ epsilon : ℝ, 0 < epsilon →
    Tendsto
      (fun n => commonRowMeasure A rowSize n
        {row | |Z n row - target| ≥ epsilon})
      atTop (nhds 0)

/-- The corresponding convergence predicate after lifting every row variable
to the common product space. -/
def CommonConvergesInProbabilityTo
    (Z : ∀ n, CommonRow A rowSize n → ℝ) (target : ℝ) : Prop :=
  ∀ epsilon : ℝ, 0 < epsilon →
    Tendsto
      (fun n => commonMeasure A rowSize
        {omega | |liftRowVariable A rowSize n (Z n) omega - target| ≥ epsilon})
      atTop (nhds 0)

/-- Every lifted deviation event has exactly its original row probability. -/
@[simp]
theorem commonDeviationProbability_eq_row
    (Z : ∀ n, CommonRow A rowSize n → ℝ)
    (target epsilon : ℝ) (n : ℕ) :
    commonMeasure A rowSize
        {omega | |liftRowVariable A rowSize n (Z n) omega - target| ≥ epsilon} =
      commonRowMeasure A rowSize n
        {row | |Z n row - target| ≥ epsilon} := by
  let s : Set (CommonRow A rowSize n) :=
    {row | |Z n row - target| ≥ epsilon}
  change commonMeasure A rowSize
      ((rowCoordinate A rowSize n) ⁻¹' s) =
    commonRowMeasure A rowSize n s
  calc
    commonMeasure A rowSize ((rowCoordinate A rowSize n) ⁻¹' s) =
        ((commonMeasure A rowSize).map
          (rowCoordinate A rowSize n)) s :=
      (Measure.map_apply (rowCoordinate_measurable A rowSize n)
        MeasurableSet.of_discrete).symm
    _ = commonRowMeasure A rowSize n s := by
      rw [commonMeasure_map_coordinate A rowSize n]

theorem commonConvergesInProbabilityTo_iff_row
    (Z : ∀ n, CommonRow A rowSize n → ℝ) (target : ℝ) :
    CommonConvergesInProbabilityTo A rowSize Z target ↔
      RowConvergesInProbabilityTo A rowSize Z target := by
  constructor
  · intro h epsilon hepsilon
    simpa only [commonDeviationProbability_eq_row A] using
      h epsilon hepsilon
  · intro h epsilon hepsilon
    simpa only [commonDeviationProbability_eq_row A] using
      h epsilon hepsilon

def RowPredictableVarianceConvergesTo (sigmaSq : ℝ) : Prop :=
  RowConvergesInProbabilityTo A rowSize
    (fun n row => (A n).explicitNormalizedFisher (rowSize n) row.1) sigmaSq

def CommonPredictableVarianceConvergesTo (sigmaSq : ℝ) : Prop :=
  CommonConvergesInProbabilityTo A rowSize
    (fun n row => (A n).explicitNormalizedFisher (rowSize n) row.1) sigmaSq

theorem commonPredictableVarianceConvergesTo_iff_row
    (sigmaSq : ℝ) :
    CommonPredictableVarianceConvergesTo A rowSize sigmaSq ↔
      RowPredictableVarianceConvergesTo A rowSize sigmaSq :=
  commonConvergesInProbabilityTo_iff_row A rowSize
    (fun n row => (A n).explicitNormalizedFisher (rowSize n) row.1) sigmaSq

def RowLindebergConvergesToZero : Prop :=
  ∀ epsilon : ℝ, 0 < epsilon →
    RowConvergesInProbabilityTo A rowSize
      (fun n row => (A n).conditionalLindebergSum
        (rowSize n) row.1 epsilon) 0

def CommonLindebergConvergesToZero : Prop :=
  ∀ epsilon : ℝ, 0 < epsilon →
    CommonConvergesInProbabilityTo A rowSize
      (fun n row => (A n).conditionalLindebergSum
        (rowSize n) row.1 epsilon) 0

theorem commonLindebergConvergesToZero_iff_row :
    CommonLindebergConvergesToZero A rowSize ↔
      RowLindebergConvergesToZero A rowSize := by
  constructor
  · intro h epsilon hepsilon
    exact (commonConvergesInProbabilityTo_iff_row A rowSize
      (fun n row => (A n).conditionalLindebergSum
        (rowSize n) row.1 epsilon) 0).1
        (h epsilon hepsilon)
  · intro h epsilon hepsilon
    exact (commonConvergesInProbabilityTo_iff_row A rowSize
      (fun n row => (A n).conditionalLindebergSum
        (rowSize n) row.1 epsilon) 0).2
        (h epsilon hepsilon)

end CommonSpace

end MixedExactCycleScalarTriangularArrayData
end QubitOracle.Paper
