import QubitOracle.Paper.OneQubitGeneralScheduleActualControllerConsistency
import QubitOracle.Paper.OneQubitGeneralScheduleCumulativePilotInformation

/-!
# Same-path Bures information for arbitrary predetermined batches

The information functional in this module is the manuscript's completed-batch
predictable matrix average.  Unlike the earlier common-marginal coupling, its
controller is evaluated on the literal Ionescu--Tulcea Born path that also
drives the score martingale.
-/

namespace QubitOracle.Paper

open Filter MeasureTheory
open scoped BigOperators Topology
open OneQubitPredeterminedBatchHeadline
open PureMultilevelSequentialBatchAdaptive

noncomputable section

/-- Batch-size-weighted exploitation information generated by the controller
actually computed from the finite adaptive trajectory prefixes. -/
def generalScheduleActualBuresExploitationInformation
    (schedule : CumulativePauliPilotBatchSchedule)
    (theta b : RLSVector 3)
    (path : AdaptiveInfinitePath BinaryOutcome) :
    Nat -> Matrix (Fin 3) (Fin 3) Real :=
  batchWeightedMatrixAverage schedule.budget.batchSize
    (fun k => generalScheduleBuresControllerInformation theta b
      (generalScheduleActualBatchStartController schedule k path))

/-- The completed-batch predictable information functional on the literal
adaptive path: cyclic-Pauli exploration plus the actual past-only controller's
Bures exploitation frame. -/
def generalScheduleActualFullBuresInformation
    (schedule : CumulativePauliPilotBatchSchedule)
    (theta b : RLSVector 3)
    (path : AdaptiveInfinitePath BinaryOutcome) :
    Nat -> Matrix (Fin 3) (Fin 3) Real :=
  batchedPredictableMatrixAverage schedule.budget.batchSize
    schedule.budget.explorationSize
    (fun k => generalScheduleBuresControllerInformation theta b
      (generalScheduleActualBatchStartController schedule k path))
    (fun _ => generalSchedulePauliExplorationInformation theta)

/-- On the same literal adaptive Born path, the actual controller's
batch-weighted exploitation information converges to the Bures target. -/
theorem generalScheduleActualBuresExploitationInformation_tendsto_ae
    (schedule : CumulativePauliPilotBatchSchedule) (b : RLSVector 3)
    (theta : OneQubitPhysicalParameter)
    (hTruth : QubitOracle.MixedNonzeroInteriorTruth theta.1)
    (hSeed : LocalFrameSeedNonparallelAt b theta.1) :
    ∀ᵐ path ∂generalScheduleAdaptiveBornPathMeasure schedule b theta,
      BatchMatrixEntrywiseTendsto
        (generalScheduleActualBuresExploitationInformation
          schedule theta.1 b path)
        (mixedBuresTarget theta.1) := by
  filter_upwards
      [generalScheduleActualBatchStartController_tendsto_ae
        schedule b theta hTruth.2]
      with path hcontroller
  have htotal : Tendsto
      (fun K => ∑ k ∈ Finset.range K,
        (schedule.budget.batchSize k : Real)) atTop atTop := by
    simpa [cumulativeCount] using
      schedule.budget.totalSamples_tendsto_atTop
  have hexploitation : BatchMatrixEntrywiseTendsto
      (fun k => generalScheduleBuresControllerInformation theta.1 b
        (generalScheduleActualBatchStartController schedule k path))
      (mixedPolynomialTruthFrameInformationMatrix theta.1 b) := by
    intro i j
    exact generalScheduleBuresControllerInformation_entry_tendsto
      theta.1 b
      (fun k => generalScheduleActualBatchStartController schedule k path)
      hcontroller hTruth hSeed i j
  have hweighted := batchWeightedMatrixAverage_tendsto
    schedule.budget.batchSize
    (fun k => generalScheduleBuresControllerInformation theta.1 b
      (generalScheduleActualBatchStartController schedule k path))
    (mixedPolynomialTruthFrameInformationMatrix theta.1 b)
    htotal hexploitation
  rw [mixedPolynomialTruthFrameInformationMatrix_eq_mixedBuresTarget
    theta.1 b hTruth hSeed] at hweighted
  simpa [generalScheduleActualBuresExploitationInformation] using hweighted

/-- Same-path convergence of the full completed-batch Bures information
functional.  No protocol-convergence axiom is used. -/
theorem generalScheduleActualFullBuresInformation_tendsto_ae
    (schedule : CumulativePauliPilotBatchSchedule) (b : RLSVector 3)
    (theta : OneQubitPhysicalParameter)
    (hTruth : QubitOracle.MixedNonzeroInteriorTruth theta.1)
    (hSeed : LocalFrameSeedNonparallelAt b theta.1) :
    ∀ᵐ path ∂generalScheduleAdaptiveBornPathMeasure schedule b theta,
      BatchMatrixEntrywiseTendsto
        (generalScheduleActualFullBuresInformation schedule theta.1 b path)
        (mixedBuresTarget theta.1) := by
  filter_upwards
      [generalScheduleActualBatchStartController_tendsto_ae
        schedule b theta hTruth.2]
      with path hcontroller
  have htotal : Tendsto
      (fun K => ∑ k ∈ Finset.range K,
        (schedule.budget.batchSize k : Real)) atTop atTop := by
    simpa [cumulativeCount] using
      schedule.budget.totalSamples_tendsto_atTop
  have hexploitation : BatchMatrixEntrywiseTendsto
      (fun k => generalScheduleBuresControllerInformation theta.1 b
        (generalScheduleActualBatchStartController schedule k path))
      (mixedPolynomialTruthFrameInformationMatrix theta.1 b) := by
    intro i j
    exact generalScheduleBuresControllerInformation_entry_tendsto
      theta.1 b
      (fun k => generalScheduleActualBatchStartController schedule k path)
      hcontroller hTruth hSeed i j
  have hfull := batchedPredictableMatrixAverage_tendsto
    schedule.budget.batchSize schedule.budget.explorationSize
    (fun k => generalScheduleBuresControllerInformation theta.1 b
      (generalScheduleActualBatchStartController schedule k path))
    (fun _ => generalSchedulePauliExplorationInformation theta.1)
    (mixedPolynomialTruthFrameInformationMatrix theta.1 b)
    (fun _ _ => 2 * (1 - QubitOracle.blochNormSq theta.1)⁻¹)
    htotal hexploitation
    (fun _ _ => mul_nonneg (by norm_num)
      (inv_nonneg.mpr (sub_nonneg.mpr hTruth.2.le)))
    (fun k i j =>
      generalSchedulePauliExploration_sub_controller_entry_norm_le
        theta.1 b (generalScheduleActualBatchStartController schedule k path)
        hTruth i j)
    (by simpa [cumulativeCount] using
      schedule.budget.cumulativeExplorationFraction_tendsto_zero)
  rw [mixedPolynomialTruthFrameInformationMatrix_eq_mixedBuresTarget
    theta.1 b hTruth hSeed] at hfull
  simpa [generalScheduleActualFullBuresInformation] using hfull

/-- Bundled same-path non-LAN Bures endpoint: controller consistency,
exploitation-information convergence, and full predictable-information
convergence all hold simultaneously under the literal adaptive Born law. -/
theorem generalScheduleActualBuresInformation_core_closed
    (schedule : CumulativePauliPilotBatchSchedule) (b : RLSVector 3)
    (theta : OneQubitPhysicalParameter)
    (hTruth : QubitOracle.MixedNonzeroInteriorTruth theta.1)
    (hSeed : LocalFrameSeedNonparallelAt b theta.1) :
    ∀ᵐ path ∂generalScheduleAdaptiveBornPathMeasure schedule b theta,
      (∀ j : Fin 3,
        Tendsto
          (fun k => generalScheduleActualBatchStartController
            schedule k path j)
          atTop (nhds (theta.1 j))) /\
      BatchMatrixEntrywiseTendsto
        (generalScheduleActualBuresExploitationInformation
          schedule theta.1 b path)
        (mixedBuresTarget theta.1) /\
      BatchMatrixEntrywiseTendsto
        (generalScheduleActualFullBuresInformation schedule theta.1 b path)
        (mixedBuresTarget theta.1) := by
  filter_upwards
      [generalScheduleActualBatchStartController_tendsto_ae
        schedule b theta hTruth.2,
       generalScheduleActualBuresExploitationInformation_tendsto_ae
        schedule b theta hTruth hSeed,
       generalScheduleActualFullBuresInformation_tendsto_ae
        schedule b theta hTruth hSeed]
      with path hcontroller hexploitation hfull
  exact ⟨hcontroller, hexploitation, hfull⟩

end

end QubitOracle.Paper
