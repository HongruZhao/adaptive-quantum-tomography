import QubitOracle.Paper.OneQubitPauliPilotHoeffding

/-!
# Explicit product Born law for the deterministic Pauli pilot

For `q` complete deterministic Pauli blocks, a path has type
`Fin q → Fin 3 → Bool`.  Its mass is the literal finite product of the three
Pauli Born probabilities in every block.  This file proves normalization,
fixed-axis independence by measurable-rectangle factorization, and the exact
Born mean.  It then constructs the positive and negated Hoeffding data.

No concentration statement is assumed here.  The final two-sided theorem has
only the approved Hoeffding Theorem 2 contracts as its external literature
premise.
-/

open MeasureTheory Set
open scoped BigOperators ENNReal

namespace QubitOracle.Paper

noncomputable section

local instance pauliPilotPropDecidable (p : Prop) : Decidable p :=
  Classical.propDecidable p

local instance pauliPilotBornPathMeasurableSpace (q : ℕ) :
    MeasurableSpace (PauliPilotPath q) := ⊤

local instance pauliPilotBornPathMeasurableSingletonClass (q : ℕ) :
    MeasurableSingletonClass (PauliPilotPath q) where
  measurableSet_singleton _ := MeasurableSet.of_discrete

abbrev PauliPilotBlock := Fin 3 → Bool

/-- Physicality assumption for the Bloch vector used by the product law. -/
def PauliPilotPhysicalBloch (theta : RLSVector 3) : Prop :=
  (∑ j : Fin 3, theta j ^ 2) ≤ 1

/-- A physical Bloch vector has every coordinate in `[-1,1]`. -/
theorem pauliPilotPhysicalBloch_coordinate_bounds
    (theta : RLSVector 3) (hphysical : PauliPilotPhysicalBloch theta)
    (j : Fin 3) :
    -1 ≤ theta j ∧ theta j ≤ 1 := by
  have hj : theta j ^ 2 ≤ ∑ i : Fin 3, theta i ^ 2 := by
    exact Finset.single_le_sum
      (fun i _ => sq_nonneg (theta i)) (Finset.mem_univ j)
  have hjOne : theta j ^ 2 ≤ 1 := hj.trans hphysical
  constructor
  · nlinarith [sq_nonneg (theta j + 1)]
  · nlinarith [sq_nonneg (theta j - 1)]

/-! ## Explicit block and path masses -/

/-- Product Born mass of one complete three-Pauli block. -/
def pauliPilotBlockMass
    (theta : RLSVector 3) (block : PauliPilotBlock) : ℝ :=
  ∏ j : Fin 3, pauliBornProbability theta j (block j)

/-- Product Born mass of all `q` complete blocks. -/
def pauliPilotPathMass
    {q : ℕ} (theta : RLSVector 3) (path : PauliPilotPath q) : ℝ :=
  ∏ b : Fin q, pauliPilotBlockMass theta (path b)

theorem pauliPilotBlockMass_nonnegative
    (theta : RLSVector 3) (hphysical : PauliPilotPhysicalBloch theta)
    (block : PauliPilotBlock) :
    0 ≤ pauliPilotBlockMass theta block := by
  unfold pauliPilotBlockMass
  apply Finset.prod_nonneg
  intro j _
  have hj := pauliPilotPhysicalBloch_coordinate_bounds theta hphysical j
  exact pauliBornProbability_nonnegative theta j hj.1 hj.2 (block j)

theorem pauliPilotPathMass_nonnegative
    {q : ℕ} (theta : RLSVector 3)
    (hphysical : PauliPilotPhysicalBloch theta)
    (path : PauliPilotPath q) :
    0 ≤ pauliPilotPathMass theta path := by
  unfold pauliPilotPathMass
  exact Finset.prod_nonneg
    (fun b _ => pauliPilotBlockMass_nonnegative theta hphysical (path b))

/-- The three-axis Born mass in one complete block is normalized. -/
theorem pauliPilotBlockMass_sum_one
    (theta : RLSVector 3) :
    ∑ block : PauliPilotBlock, pauliPilotBlockMass theta block = 1 := by
  unfold pauliPilotBlockMass
  rw [← Fintype.prod_sum]
  simp_rw [pauliBornProbability_sum_one]
  simp

/-- The complete `q`-block product mass is normalized, including `q = 0`. -/
theorem pauliPilotPathMass_sum_one
    {q : ℕ} (theta : RLSVector 3) :
    ∑ path : PauliPilotPath q, pauliPilotPathMass theta path = 1 := by
  unfold pauliPilotPathMass
  rw [← Fintype.prod_sum]
  simp_rw [pauliPilotBlockMass_sum_one]
  simp

/-! ## The finite product measure -/

/-- Explicit finite Dirac-sum measure generated by the product Born mass. -/
def pauliPilotBornProductMeasure
    {q : ℕ} (theta : RLSVector 3) : Measure (PauliPilotPath q) :=
  Measure.sum fun path : PauliPilotPath q =>
    ENNReal.ofReal (pauliPilotPathMass theta path) • Measure.dirac path

private theorem ennreal_ofReal_finset_sum_nonnegative
    {α : Type*} [DecidableEq α]
    (s : Finset α) (f : α → ℝ) (hf : ∀ a, 0 ≤ f a) :
    ENNReal.ofReal (∑ a ∈ s, f a) =
      ∑ a ∈ s, ENNReal.ofReal (f a) := by
  induction s using Finset.induction_on with
  | empty => simp
  | @insert a s ha ih =>
      rw [Finset.sum_insert ha, Finset.sum_insert ha,
        ENNReal.ofReal_add (hf a)
          (Finset.sum_nonneg fun i _ => hf i), ih]

private theorem ennreal_ofReal_finset_prod_nonnegative
    {α : Type*} [DecidableEq α]
    (s : Finset α) (f : α → ℝ) (hf : ∀ a, 0 ≤ f a) :
    ENNReal.ofReal (∏ a ∈ s, f a) =
      ∏ a ∈ s, ENNReal.ofReal (f a) := by
  induction s using Finset.induction_on with
  | empty => simp
  | @insert a s ha ih =>
      rw [Finset.prod_insert ha, Finset.prod_insert ha,
        ENNReal.ofReal_mul (hf a), ih]

private theorem ennreal_ofReal_fintype_prod_nonnegative
    {α : Type*} [Fintype α] [DecidableEq α]
    (f : α → ℝ) (hf : ∀ a, 0 ≤ f a) :
    ENNReal.ofReal (∏ a, f a) = ∏ a, ENNReal.ofReal (f a) := by
  exact ennreal_ofReal_finset_prod_nonnegative Finset.univ f hf

/-- Evaluation of the explicit finite measure on an arbitrary event. -/
theorem pauliPilotBornProductMeasure_apply
    {q : ℕ} (theta : RLSVector 3)
    (hphysical : PauliPilotPhysicalBloch theta)
    (event : Set (PauliPilotPath q)) :
    pauliPilotBornProductMeasure (q := q) theta event =
      ENNReal.ofReal
        (∑ path : PauliPilotPath q,
          if path ∈ event then pauliPilotPathMass theta path else 0) := by
  unfold pauliPilotBornProductMeasure
  rw [Measure.sum_apply _ (MeasurableSet.of_discrete), tsum_fintype]
  calc
    (∑ path : PauliPilotPath q,
        (ENNReal.ofReal (pauliPilotPathMass theta path) •
          Measure.dirac path) event) =
      ∑ path : PauliPilotPath q,
        ENNReal.ofReal
          (if path ∈ event then pauliPilotPathMass theta path else 0) := by
        apply Finset.sum_congr rfl
        intro path _
        by_cases hpath : path ∈ event
        · simp [Measure.smul_apply, hpath,
            MeasurableSet.of_discrete]
        · simp [Measure.smul_apply, hpath,
            MeasurableSet.of_discrete]
    _ = ENNReal.ofReal
        (∑ path : PauliPilotPath q,
          if path ∈ event then pauliPilotPathMass theta path else 0) := by
      symm
      apply ennreal_ofReal_finset_sum_nonnegative
      intro path
      by_cases hpath : path ∈ event
      · simp [hpath, pauliPilotPathMass_nonnegative theta hphysical path]
      · simp [hpath]

/-- The explicit product measure has total mass one. -/
theorem pauliPilotBornProductMeasure_univ
    {q : ℕ} (theta : RLSVector 3)
    (hphysical : PauliPilotPhysicalBloch theta) :
    pauliPilotBornProductMeasure (q := q) theta univ = 1 := by
  rw [pauliPilotBornProductMeasure_apply theta hphysical]
  simp [pauliPilotPathMass_sum_one]

/-! ## Rectangle factorization -/

/-- Real mass assigned to an arbitrary event in one complete Pauli block. -/
def pauliPilotBlockEventMass
    (theta : RLSVector 3) (event : Set PauliPilotBlock) : ℝ :=
  ∑ block : PauliPilotBlock,
    if block ∈ event then pauliPilotBlockMass theta block else 0

theorem pauliPilotBlockEventMass_nonnegative
    (theta : RLSVector 3) (hphysical : PauliPilotPhysicalBloch theta)
    (event : Set PauliPilotBlock) :
    0 ≤ pauliPilotBlockEventMass theta event := by
  unfold pauliPilotBlockEventMass
  apply Finset.sum_nonneg
  intro block _
  by_cases hblock : block ∈ event
  · simp [hblock, pauliPilotBlockMass_nonnegative theta hphysical block]
  · simp [hblock]

theorem pauliPilotBlockEventMass_univ
    (theta : RLSVector 3) :
    pauliPilotBlockEventMass theta univ = 1 := by
  simp [pauliPilotBlockEventMass, pauliPilotBlockMass_sum_one]

private theorem pauliPilotRectangleIndicatorMass_eq_prod
    {q : ℕ} (theta : RLSVector 3)
    (events : Fin q → Set PauliPilotBlock)
    (path : PauliPilotPath q) :
    (if (∀ b, path b ∈ events b) then pauliPilotPathMass theta path else 0) =
      ∏ b : Fin q,
        if path b ∈ events b then pauliPilotBlockMass theta (path b) else 0 := by
  classical
  by_cases hall : ∀ b, path b ∈ events b
  · simp [hall, pauliPilotPathMass]
  · have hexists : ∃ b, path b ∉ events b := by
      simpa only [not_forall] using hall
    obtain ⟨b, hb⟩ := hexists
    rw [if_neg hall]
    symm
    exact Finset.prod_eq_zero (Finset.mem_univ b) (by simp [hb])

/-- Real rectangle mass factors over the deterministic complete blocks. -/
theorem pauliPilotRectangleRealMass_factorization
    {q : ℕ} (theta : RLSVector 3)
    (events : Fin q → Set PauliPilotBlock) :
    (∑ path : PauliPilotPath q,
      if (∀ b, path b ∈ events b) then pauliPilotPathMass theta path else 0) =
      ∏ b : Fin q, pauliPilotBlockEventMass theta (events b) := by
  calc
    (∑ path : PauliPilotPath q,
      if (∀ b, path b ∈ events b) then pauliPilotPathMass theta path else 0) =
      ∑ path : PauliPilotPath q,
        ∏ b : Fin q,
          if path b ∈ events b then
            pauliPilotBlockMass theta (path b) else 0 := by
      apply Finset.sum_congr rfl
      intro path _
      exact pauliPilotRectangleIndicatorMass_eq_prod theta events path
    _ = ∏ b : Fin q,
        ∑ block : PauliPilotBlock,
          if block ∈ events b then pauliPilotBlockMass theta block else 0 := by
      exact (Fintype.prod_sum (fun b block =>
        if block ∈ events b then pauliPilotBlockMass theta block else 0)).symm
    _ = ∏ b : Fin q, pauliPilotBlockEventMass theta (events b) := rfl

/-- Measurable-rectangle factorization for the block projections. -/
theorem pauliPilotBornProductMeasure_blockRectangle
    {q : ℕ} (theta : RLSVector 3)
    (hphysical : PauliPilotPhysicalBloch theta)
    (events : Fin q → Set PauliPilotBlock) :
    pauliPilotBornProductMeasure (q := q) theta
        (⋂ b, (fun path : PauliPilotPath q => path b) ⁻¹' events b) =
      ∏ b : Fin q,
        ENNReal.ofReal (pauliPilotBlockEventMass theta (events b)) := by
  rw [pauliPilotBornProductMeasure_apply theta hphysical]
  have hreal := pauliPilotRectangleRealMass_factorization theta events
  rw [show
    (∑ path : PauliPilotPath q,
      if path ∈
          (⋂ b, (fun path : PauliPilotPath q => path b) ⁻¹' events b)
        then pauliPilotPathMass theta path else 0) =
      ∏ b : Fin q, pauliPilotBlockEventMass theta (events b) by
        simpa only [Set.mem_iInter, Set.mem_preimage] using hreal]
  exact ennreal_ofReal_fintype_prod_nonnegative
    (fun b : Fin q => pauliPilotBlockEventMass theta (events b))
    (fun b => pauliPilotBlockEventMass_nonnegative
      theta hphysical (events b))

/-- Marginal event formula for any selected complete block. -/
theorem pauliPilotBornProductMeasure_singleBlock
    {q : ℕ} (theta : RLSVector 3)
    (hphysical : PauliPilotPhysicalBloch theta)
    (b : Fin q) (event : Set PauliPilotBlock) :
    pauliPilotBornProductMeasure (q := q) theta
        ((fun path : PauliPilotPath q => path b) ⁻¹' event) =
      ENNReal.ofReal (pauliPilotBlockEventMass theta event) := by
  let events : Fin q → Set PauliPilotBlock :=
    fun i => if i = b then event else univ
  have hrectangle :=
    pauliPilotBornProductMeasure_blockRectangle theta hphysical events
  have hset :
      (⋂ i, (fun path : PauliPilotPath q => path i) ⁻¹' events i) =
        (fun path : PauliPilotPath q => path b) ⁻¹' event := by
    ext path
    constructor
    · intro hpath
      have hb := Set.mem_iInter.mp hpath b
      simpa [events] using hb
    · intro hb
      apply Set.mem_iInter.mpr
      intro i
      by_cases hib : i = b
      · subst i
        simpa [events] using hb
      · simp [events, hib]
  rw [hset] at hrectangle
  calc
    pauliPilotBornProductMeasure (q := q) theta
        ((fun path : PauliPilotPath q => path b) ⁻¹' event) =
      ∏ i : Fin q,
        ENNReal.ofReal (pauliPilotBlockEventMass theta (events i)) :=
      hrectangle
    _ = ENNReal.ofReal (pauliPilotBlockEventMass theta event) := by
      rw [Finset.prod_eq_single b]
      · simp [events]
      · intro i _ hib
        simp [events, hib, pauliPilotBlockEventMass_univ]
      · simp

/-! ## Fixed-axis independence -/

/-- For each fixed Pauli axis, signs from distinct complete blocks are
independent in the exact measurable-rectangle sense used by Hoeffding data. -/
theorem pauliPilotCoordinateVariable_finiteIndependent
    {q : ℕ} (theta : RLSVector 3)
    (hphysical : PauliPilotPhysicalBloch theta) (j : Fin 3) :
    FiniteIndependentRealFamily
      (pauliPilotBornProductMeasure (q := q) theta)
      (pauliPilotCoordinateVariable (q := q) j) := by
  intro events _hEvents
  let blockEvents : Fin q → Set PauliPilotBlock := fun b =>
    {block | pauliOutcomeSign (block j) ∈ events b}
  calc
    pauliPilotBornProductMeasure (q := q) theta
        (⋂ b, pauliPilotCoordinateVariable (q := q) j b ⁻¹' events b) =
      pauliPilotBornProductMeasure (q := q) theta
        (⋂ b, (fun path : PauliPilotPath q => path b) ⁻¹' blockEvents b) := by
      congr 1
    _ = ∏ b : Fin q,
        ENNReal.ofReal (pauliPilotBlockEventMass theta (blockEvents b)) :=
      pauliPilotBornProductMeasure_blockRectangle theta hphysical blockEvents
    _ = ∏ b : Fin q,
        pauliPilotBornProductMeasure (q := q) theta
          (pauliPilotCoordinateVariable (q := q) j b ⁻¹' events b) := by
      apply Finset.prod_congr rfl
      intro b _
      calc
        ENNReal.ofReal (pauliPilotBlockEventMass theta (blockEvents b)) =
            pauliPilotBornProductMeasure (q := q) theta
              ((fun path : PauliPilotPath q => path b) ⁻¹' blockEvents b) :=
          (pauliPilotBornProductMeasure_singleBlock
            theta hphysical b (blockEvents b)).symm
        _ = pauliPilotBornProductMeasure (q := q) theta
            (pauliPilotCoordinateVariable (q := q) j b ⁻¹' events b) := by
          congr 1

/-! ## Exact Born means -/

/-- The one-observation signed Born mean is the corresponding Bloch
coordinate. -/
theorem pauliBornProbability_sign_mean
    (theta : RLSVector 3) (j : Fin 3) :
    ∑ outcome : Bool,
      pauliBornProbability theta j outcome * pauliOutcomeSign outcome =
      theta j := by
  simp [pauliBornProbability, pauliOutcomeSign]
  ring

private def pauliPilotMarkedAxisFactor
    (theta : RLSVector 3) (j k : Fin 3) (outcome : Bool) : ℝ :=
  pauliBornProbability theta k outcome *
    (if k = j then pauliOutcomeSign outcome else 1)

private theorem pauliPilotMarkedAxisFactor_prod
    (theta : RLSVector 3) (j : Fin 3) (block : PauliPilotBlock) :
    (∏ k : Fin 3, pauliPilotMarkedAxisFactor theta j k (block k)) =
      pauliPilotBlockMass theta block * pauliOutcomeSign (block j) := by
  unfold pauliPilotMarkedAxisFactor pauliPilotBlockMass
  rw [Finset.prod_mul_distrib]
  have hsign :
      (∏ k : Fin 3, if k = j then pauliOutcomeSign (block k) else 1) =
        pauliOutcomeSign (block j) := by
    rw [Finset.prod_eq_single j]
    · simp
    · intro k _ hkj
      simp [hkj]
    · simp
  rw [hsign]

/-- One complete three-axis block has the correct fixed-axis Born mean. -/
theorem pauliPilotBlock_sign_mean
    (theta : RLSVector 3) (j : Fin 3) :
    ∑ block : PauliPilotBlock,
      pauliPilotBlockMass theta block * pauliOutcomeSign (block j) =
      theta j := by
  calc
    (∑ block : PauliPilotBlock,
      pauliPilotBlockMass theta block * pauliOutcomeSign (block j)) =
      ∑ block : PauliPilotBlock,
        ∏ k : Fin 3, pauliPilotMarkedAxisFactor theta j k (block k) := by
      apply Finset.sum_congr rfl
      intro block _
      exact (pauliPilotMarkedAxisFactor_prod theta j block).symm
    _ = ∏ k : Fin 3,
        ∑ outcome : Bool, pauliPilotMarkedAxisFactor theta j k outcome := by
      rw [← Fintype.prod_sum]
    _ = theta j := by
      rw [Finset.prod_eq_single j]
      · simpa [pauliPilotMarkedAxisFactor] using
          pauliBornProbability_sign_mean theta j
      · intro k _ hkj
        simpa [pauliPilotMarkedAxisFactor, hkj, add_comm] using
          pauliBornProbability_sum_one theta k
      · simp

private def pauliPilotMarkedBlockFactor
    (theta : RLSVector 3) {q : ℕ} (b i : Fin q)
    (observable : PauliPilotBlock → ℝ) (block : PauliPilotBlock) : ℝ :=
  pauliPilotBlockMass theta block *
    (if i = b then observable block else 1)

private theorem pauliPilotMarkedBlockFactor_prod
    {q : ℕ} (theta : RLSVector 3) (b : Fin q)
    (observable : PauliPilotBlock → ℝ) (path : PauliPilotPath q) :
    (∏ i : Fin q,
      pauliPilotMarkedBlockFactor theta b i observable (path i)) =
      pauliPilotPathMass theta path * observable (path b) := by
  unfold pauliPilotMarkedBlockFactor pauliPilotPathMass
  rw [Finset.prod_mul_distrib]
  have hobservable :
      (∏ i : Fin q, if i = b then observable (path i) else 1) =
        observable (path b) := by
    rw [Finset.prod_eq_single b]
    · simp
    · intro i _ hib
      simp [hib]
    · simp
  rw [hobservable]

/-- A product-path expectation of a one-block observable reduces to the
corresponding one-block expectation. -/
theorem pauliPilotPath_singleBlock_mean
    {q : ℕ} (theta : RLSVector 3) (b : Fin q)
    (observable : PauliPilotBlock → ℝ) :
    ∑ path : PauliPilotPath q,
      pauliPilotPathMass theta path * observable (path b) =
      ∑ block : PauliPilotBlock,
        pauliPilotBlockMass theta block * observable block := by
  calc
    (∑ path : PauliPilotPath q,
      pauliPilotPathMass theta path * observable (path b)) =
      ∑ path : PauliPilotPath q,
        ∏ i : Fin q,
          pauliPilotMarkedBlockFactor theta b i observable (path i) := by
      apply Finset.sum_congr rfl
      intro path _
      exact (pauliPilotMarkedBlockFactor_prod
        theta b observable path).symm
    _ = ∏ i : Fin q,
        ∑ block : PauliPilotBlock,
          pauliPilotMarkedBlockFactor theta b i observable block := by
      rw [← Fintype.prod_sum]
    _ = ∑ block : PauliPilotBlock,
        pauliPilotBlockMass theta block * observable block := by
      rw [Finset.prod_eq_single b]
      · simp [pauliPilotMarkedBlockFactor]
      · intro i _ hib
        simp [pauliPilotMarkedBlockFactor, hib,
          pauliPilotBlockMass_sum_one]
      · simp

/-- Finite-sum integral formula for the explicit product measure. -/
theorem integral_pauliPilotBornProductMeasure
    {q : ℕ} (theta : RLSVector 3)
    (hphysical : PauliPilotPhysicalBloch theta)
    (f : PauliPilotPath q → ℝ) :
    ∫ path, f path ∂pauliPilotBornProductMeasure (q := q) theta =
      ∑ path : PauliPilotPath q, pauliPilotPathMass theta path * f path := by
  have hfint : Integrable f (pauliPilotBornProductMeasure (q := q) theta) := by
    unfold pauliPilotBornProductMeasure
    apply integrable_sum_measure
    · intro path
      exact (integrable_dirac (by finiteness)).smul_measure (by finiteness)
    · exact summable_of_finite_support (Set.toFinite _)
  unfold pauliPilotBornProductMeasure at hfint ⊢
  rw [integral_sum_measure hfint, tsum_fintype]
  apply Finset.sum_congr rfl
  intro path _
  rw [integral_smul_measure, integral_dirac]
  simp [ENNReal.toReal_ofReal
    (pauliPilotPathMass_nonnegative theta hphysical path), smul_eq_mul]

/-- Every blockwise fixed-axis sign integral is exactly the Born mean
`theta j`; it is not left as a premise. -/
theorem integral_pauliPilotCoordinateVariable_eq
    {q : ℕ} (theta : RLSVector 3)
    (hphysical : PauliPilotPhysicalBloch theta)
    (j : Fin 3) (b : Fin q) :
    (∫ path, pauliPilotCoordinateVariable (q := q) j b path
      ∂pauliPilotBornProductMeasure (q := q) theta) = theta j := by
  rw [integral_pauliPilotBornProductMeasure (q := q) theta hphysical]
  calc
    (∑ path : PauliPilotPath q,
      pauliPilotPathMass theta path *
        pauliPilotCoordinateVariable (q := q) j b path) =
      ∑ block : PauliPilotBlock,
        pauliPilotBlockMass theta block * pauliOutcomeSign (block j) := by
      simpa [pauliPilotCoordinateVariable] using
        pauliPilotPath_singleBlock_mean theta b
          (fun block => pauliOutcomeSign (block j))
    _ = theta j := pauliPilotBlock_sign_mean theta j

/-- The negated family has the corresponding negated Born mean. -/
theorem integral_pauliPilotNegativeCoordinateVariable_eq
    {q : ℕ} (theta : RLSVector 3)
    (hphysical : PauliPilotPhysicalBloch theta)
    (j : Fin 3) (b : Fin q) :
    (∫ path, pauliPilotNegativeCoordinateVariable (q := q) j b path
      ∂pauliPilotBornProductMeasure (q := q) theta) = -theta j := by
  have hmean :
      (∫ path : PauliPilotPath q, pauliOutcomeSign (path b j)
        ∂pauliPilotBornProductMeasure (q := q) theta) = theta j := by
    simpa [pauliPilotCoordinateVariable] using
      integral_pauliPilotCoordinateVariable_eq
        (q := q) theta hphysical j b
  unfold pauliPilotNegativeCoordinateVariable
  rw [integral_neg, hmean]

/-! ## Fully discharged Hoeffding data -/

/-- Positive-sign Hoeffding data for the explicit Born product law. -/
def pauliPilotBornPositiveHoeffdingData
    {q : ℕ} (hq : 0 < q) (theta : RLSVector 3)
    (hphysical : PauliPilotPhysicalBloch theta) (j : Fin 3) :
    HoeffdingTheorem2Data (Ω := PauliPilotPath q) q :=
  pauliPilotPositiveHoeffdingData hq
    (pauliPilotBornProductMeasure (q := q) theta) j
    (pauliPilotBornProductMeasure_univ (q := q) theta hphysical)
    (pauliPilotCoordinateVariable_finiteIndependent (q := q) theta hphysical j)

/-- Negated-sign Hoeffding data for the explicit Born product law. -/
def pauliPilotBornNegativeHoeffdingData
    {q : ℕ} (hq : 0 < q) (theta : RLSVector 3)
    (hphysical : PauliPilotPhysicalBloch theta) (j : Fin 3) :
    HoeffdingTheorem2Data (Ω := PauliPilotPath q) q :=
  pauliPilotNegativeHoeffdingData hq
    (pauliPilotBornProductMeasure (q := q) theta) j
    (pauliPilotBornProductMeasure_univ (q := q) theta hphysical)
    (pauliPilotCoordinateVariable_finiteIndependent (q := q) theta hphysical j)

/-- The only remaining literature boundary for the two-sided coordinate tail:
Hoeffding Theorem 2 for the positive and negated data just constructed. -/
def PauliPilotBornTwoSidedHoeffdingTheorem2Contract
    {q : ℕ} (hq : 0 < q) (theta : RLSVector 3)
    (hphysical : PauliPilotPhysicalBloch theta) (j : Fin 3) : Prop :=
  Hoeffding1963Theorem2Contract
      (pauliPilotBornPositiveHoeffdingData hq theta hphysical j) ∧
    Hoeffding1963Theorem2Contract
      (pauliPilotBornNegativeHoeffdingData hq theta hphysical j)

/-- Closed project-specific reduction to the approved Hoeffding contract.
Normalization, independence, and the Born mean are all supplied internally. -/
theorem pauliPilotBorn_twoSidedTail_of_hoeffding2
    {q : ℕ} (hq : 0 < q) (theta : RLSVector 3)
    (hphysical : PauliPilotPhysicalBloch theta) (j : Fin 3)
    (hHoeffding : PauliPilotBornTwoSidedHoeffdingTheorem2Contract
      hq theta hphysical j)
    (t : ℝ) (ht : 0 < t) :
    pauliPilotBornProductMeasure (q := q) theta
        {path | t ≤ |pauliPilotEstimate path j - theta j|} ≤
      2 * ENNReal.ofReal (Real.exp (-(q : ℝ) * t ^ 2 / 2)) := by
  exact pauliPilot_twoSidedTail_of_hoeffding2
    hq (pauliPilotBornProductMeasure (q := q) theta) theta j
    (pauliPilotBornProductMeasure_univ (q := q) theta hphysical)
    (pauliPilotCoordinateVariable_finiteIndependent (q := q) theta hphysical j)
    (fun b => integral_pauliPilotCoordinateVariable_eq
      theta hphysical j b)
    hHoeffding.1 hHoeffding.2 t ht

end

end QubitOracle.Paper
