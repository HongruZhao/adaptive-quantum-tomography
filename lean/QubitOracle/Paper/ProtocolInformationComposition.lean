import QubitOracle.Paper.AdaptiveTrajectoryExperiment
import QubitOracle.Paper.CanonicalResolvedLabels
import QubitOracle.Paper.PaperProtocolDefinitions
import Mathlib.MeasureTheory.Measure.MeasureSpaceDef

/-!
# Protocol information composition

This file formalizes the deterministic algebra used in the information-
convergence proof of the manuscript.  It deliberately separates four inputs:

* realized one-round information;
* its predictable conditional mean;
* exploitation and exploration contributions to that conditional mean;
* regular and exceptional rounds.

The main conclusions are finite-sample identities and limit-transfer theorems.
No central limit theorem, concentration theorem, or scientific result is
postulated here.  The four `*_information_decomposition` label names requested
for the formalization are compatibility names: the current TeX expresses their
content in `eq:SI_info_martingale` and `eq:SI_predictable_decompose`, rather
than declaring those four strings as literal LaTeX labels.
-/

open scoped BigOperators Topology
open Filter Finset MeasureTheory

namespace QubitOracle.Paper

noncomputable section

universe u v

/-- The manuscript's normalized accumulated information, with Lean's
zero-based shot indexing. -/
def normalizedProtocolInformation {E : Type u} [AddCommMonoid E] [Module Real E]
    (information : Nat -> E) (N : Nat) : E :=
  (N : Real)⁻¹ • ∑ i ∈ Finset.range N, information i

/-- The martingale innovation `D_i = I_i - bar I_i`. -/
def informationInnovation {E : Type u} [Sub E]
    (realized predictable : Nat -> E) (i : Nat) : E :=
  realized i - predictable i

/-- The exploitation contribution in the predictable mixture. -/
def exploitationInformation {E : Type u} [SMul Real E]
    (epsilon : Nat -> Real) (exploitation : Nat -> E) (i : Nat) : E :=
  (1 - epsilon i) • exploitation i

/-- The exploration contribution in the predictable mixture. -/
def explorationInformation {E : Type u} [SMul Real E]
    (epsilon : Nat -> Real) (exploration : Nat -> E) (i : Nat) : E :=
  epsilon i • exploration i

/-- The conditional information generated by the exploration/exploitation
mixture in `eq:SI_predictable_decompose`. -/
def predictableMixtureInformation {E : Type u} [Add E] [SMul Real E]
    (epsilon : Nat -> Real) (exploitation exploration : Nat -> E) (i : Nat) : E :=
  exploitationInformation epsilon exploitation i +
    explorationInformation epsilon exploration i

section FiniteSumAlgebra

variable {E : Type u} [AddCommGroup E] [Module Real E]

/-- Normalized summation commutes with pointwise addition. -/
theorem normalizedProtocolInformation_add
    (f g : Nat -> E) (N : Nat) :
    normalizedProtocolInformation (fun i => f i + g i) N =
      normalizedProtocolInformation f N + normalizedProtocolInformation g N := by
  simp [normalizedProtocolInformation, Finset.sum_add_distrib, smul_add]

/-- Exact finite-sample realized/predictable/innovation decomposition. -/
theorem normalizedProtocolInformation_realized_decomposition
    (realized predictable : Nat -> E) (N : Nat) :
    normalizedProtocolInformation realized N =
      normalizedProtocolInformation predictable N +
        normalizedProtocolInformation
          (informationInnovation realized predictable) N := by
  rw [← normalizedProtocolInformation_add]
  congr 1
  funext i
  simp [informationInnovation]

/-- Exact finite-sample exploitation/exploration decomposition.  Its only
hypothesis is the primitive per-round mixture identity from the protocol. -/
theorem normalizedProtocolInformation_predictable_decomposition
    (predictable : Nat -> E) (epsilon : Nat -> Real)
    (exploitation exploration : Nat -> E)
    (hround : ∀ i,
      predictable i = predictableMixtureInformation epsilon exploitation exploration i)
    (N : Nat) :
    normalizedProtocolInformation predictable N =
      normalizedProtocolInformation
          (exploitationInformation epsilon exploitation) N +
        normalizedProtocolInformation
          (explorationInformation epsilon exploration) N := by
  have hfun : predictable =
      predictableMixtureInformation epsilon exploitation exploration := by
    funext i
    exact hround i
  rw [hfun]
  exact normalizedProtocolInformation_add _ _ N

/-- Full three-term composition used in both the mixed and rank-one proofs. -/
theorem normalizedProtocolInformation_full_decomposition
    (realized predictable : Nat -> E) (epsilon : Nat -> Real)
    (exploitation exploration : Nat -> E)
    (hround : ∀ i,
      predictable i = predictableMixtureInformation epsilon exploitation exploration i)
    (N : Nat) :
    normalizedProtocolInformation realized N =
      (normalizedProtocolInformation
          (exploitationInformation epsilon exploitation) N +
        normalizedProtocolInformation
          (explorationInformation epsilon exploration) N) +
        normalizedProtocolInformation
          (informationInnovation realized predictable) N := by
  rw [normalizedProtocolInformation_realized_decomposition]
  rw [normalizedProtocolInformation_predictable_decomposition predictable epsilon
    exploitation exploration hround]

end FiniteSumAlgebra

/-! ## Stage and block sums -/

/-- Unnormalized information in the consecutive block
`start, ..., start + length - 1`. -/
def protocolInformationBlock {E : Type u} [AddCommMonoid E]
    (information : Nat -> E) (start length : Nat) : E :=
  ∑ j ∈ Finset.range length, information (start + j)

/-- Total number of shots in the first `K` blocks. -/
def cumulativeProtocolLength (blockSize : Nat -> Nat) (K : Nat) : Nat :=
  ∑ k ∈ Finset.range K, blockSize k

@[simp] theorem cumulativeProtocolLength_zero (blockSize : Nat -> Nat) :
    cumulativeProtocolLength blockSize 0 = 0 := by
  simp [cumulativeProtocolLength]

@[simp] theorem cumulativeProtocolLength_succ (blockSize : Nat -> Nat) (K : Nat) :
    cumulativeProtocolLength blockSize (K + 1) =
      cumulativeProtocolLength blockSize K + blockSize K := by
  simp [cumulativeProtocolLength, Finset.sum_range_succ]

section BlockAlgebra

variable {E : Type u} [AddCommMonoid E]

/-- Exact prefix-plus-next-block identity. -/
theorem accumulatedProtocolInformation_add_block
    (information : Nat -> E) (start length : Nat) :
    (∑ i ∈ Finset.range (start + length), information i) =
      (∑ i ∈ Finset.range start, information i) +
        protocolInformationBlock information start length := by
  exact Finset.sum_range_add information start length

/-- Exact telescoping of an accumulated shot sum into consecutive batches. -/
theorem accumulatedProtocolInformation_eq_sum_blocks
    (information : Nat -> E) (blockSize : Nat -> Nat) (K : Nat) :
    (∑ i ∈ Finset.range (cumulativeProtocolLength blockSize K), information i) =
      ∑ k ∈ Finset.range K,
        protocolInformationBlock information
          (cumulativeProtocolLength blockSize k) (blockSize k) := by
  induction K with
  | zero => simp
  | succ K ih =>
      calc
        (∑ i ∈ Finset.range (cumulativeProtocolLength blockSize (K + 1)), information i) =
            (∑ i ∈ Finset.range
                (cumulativeProtocolLength blockSize K + blockSize K), information i) := by
              rw [cumulativeProtocolLength_succ]
        _ = (∑ i ∈ Finset.range (cumulativeProtocolLength blockSize K), information i) +
              protocolInformationBlock information
                (cumulativeProtocolLength blockSize K) (blockSize K) :=
              accumulatedProtocolInformation_add_block information
                (cumulativeProtocolLength blockSize K) (blockSize K)
        _ = (∑ k ∈ Finset.range K,
              protocolInformationBlock information
                (cumulativeProtocolLength blockSize k) (blockSize k)) +
              protocolInformationBlock information
                (cumulativeProtocolLength blockSize K) (blockSize K) := by
              rw [ih]
        _ = ∑ k ∈ Finset.range (K + 1),
              protocolInformationBlock information
                (cumulativeProtocolLength blockSize k) (blockSize k) := by
              rw [Finset.sum_range_succ]

end BlockAlgebra

section WeightedStageAlgebra

variable {E : Type u} [AddCommMonoid E] [Module Real E]

/-- A block whose per-shot information is a scalar multiple of one stage
matrix collapses to the sum of its scalar weights times that matrix. -/
theorem protocolInformationBlock_weighted_stage
    (information : Nat -> E) (weight : Nat -> Real) (stageInformation : E)
    (start length : Nat)
    (hround : ∀ j, j < length ->
      information (start + j) = weight (start + j) • stageInformation) :
    protocolInformationBlock information start length =
      (∑ j ∈ Finset.range length, weight (start + j)) • stageInformation := by
  unfold protocolInformationBlock
  calc
    (∑ j ∈ Finset.range length, information (start + j)) =
        ∑ j ∈ Finset.range length, weight (start + j) • stageInformation := by
          apply Finset.sum_congr rfl
          intro j hj
          exact hround j (Finset.mem_range.mp hj)
    _ = (∑ j ∈ Finset.range length, weight (start + j)) • stageInformation := by
          rw [Finset.sum_smul]

/-- Exact stage/block composition, allowing the exploration weights to vary
shot by shot inside a batch while the controller-dependent stage information
is held fixed. -/
theorem accumulatedWeightedStageInformation_eq_sum_blocks
    (information : Nat -> E) (weight : Nat -> Real)
    (stageInformation : Nat -> E) (blockSize : Nat -> Nat) (K : Nat)
    (hstage : ∀ k, k < K -> ∀ j, j < blockSize k ->
      information (cumulativeProtocolLength blockSize k + j) =
        weight (cumulativeProtocolLength blockSize k + j) • stageInformation k) :
    (∑ i ∈ Finset.range (cumulativeProtocolLength blockSize K), information i) =
      ∑ k ∈ Finset.range K,
        (∑ j ∈ Finset.range (blockSize k),
          weight (cumulativeProtocolLength blockSize k + j)) • stageInformation k := by
  rw [accumulatedProtocolInformation_eq_sum_blocks information blockSize K]
  apply Finset.sum_congr rfl
  intro k hk
  exact protocolInformationBlock_weighted_stage information weight (stageInformation k)
    (cumulativeProtocolLength blockSize k) (blockSize k)
    (hstage k (Finset.mem_range.mp hk))

end WeightedStageAlgebra

/-! ## Exceptional-round comparisons -/

/-- Information retained from regular rounds. -/
def regularRoundInformation {E : Type u} [Zero E]
    (exceptional : Nat -> Bool) (information : Nat -> E) (i : Nat) : E :=
  if exceptional i = true then 0 else information i

/-- Information carried by exceptional rounds. -/
def exceptionalRoundInformation {E : Type u} [Zero E]
    (exceptional : Nat -> Bool) (information : Nat -> E) (i : Nat) : E :=
  if exceptional i = true then information i else 0

/-- Number of exceptional rounds before `N`. -/
def exceptionalRoundCount (exceptional : Nat -> Bool) (N : Nat) : Nat :=
  ((Finset.range N).filter fun i => exceptional i = true).card

/-- The deterministic scale multiplying a uniform per-round information bound. -/
def exceptionalNormalizationWeight (exceptional : Nat -> Bool) (N : Nat) : Real :=
  ‖(N : Real)⁻¹‖ * exceptionalRoundCount exceptional N

section ExceptionalAlgebra

variable {E : Type u} [AddCommGroup E] [Module Real E]

/-- Exact regular/exceptional partition at every finite horizon. -/
theorem normalizedProtocolInformation_regular_exceptional
    (exceptional : Nat -> Bool) (information : Nat -> E) (N : Nat) :
    normalizedProtocolInformation information N =
      normalizedProtocolInformation
          (regularRoundInformation exceptional information) N +
        normalizedProtocolInformation
          (exceptionalRoundInformation exceptional information) N := by
  rw [← normalizedProtocolInformation_add]
  congr 1
  funext i
  by_cases hi : exceptional i = true
  · simp [regularRoundInformation, exceptionalRoundInformation, hi]
  · simp [regularRoundInformation, exceptionalRoundInformation, hi]

end ExceptionalAlgebra

section ExceptionalBounds

variable {E : Type u} [SeminormedAddCommGroup E] [NormedSpace Real E]

/-- A uniform primitive per-round bound controls the exceptional sum by the
exceptional count. -/
theorem norm_exceptionalRoundInformation_sum_le
    (exceptional : Nat -> Bool) (information : Nat -> E)
    (B : Real) (N : Nat)
    (hbound : ∀ i, i < N -> ‖information i‖ <= B) :
    ‖∑ i ∈ Finset.range N, exceptionalRoundInformation exceptional information i‖ <=
      exceptionalRoundCount exceptional N * B := by
  calc
    ‖∑ i ∈ Finset.range N, exceptionalRoundInformation exceptional information i‖ <=
        ∑ i ∈ Finset.range N,
          ‖exceptionalRoundInformation exceptional information i‖ :=
      norm_sum_le _ _
    _ = ∑ i ∈ Finset.range N,
          if exceptional i = true then ‖information i‖ else 0 := by
      apply Finset.sum_congr rfl
      intro i hi
      by_cases h : exceptional i = true
      · simp [exceptionalRoundInformation, h]
      · simp [exceptionalRoundInformation, h]
    _ = ∑ i ∈ (Finset.range N).filter (fun i => exceptional i = true),
          ‖information i‖ := by
      rw [Finset.sum_filter]
    _ <= ∑ _i ∈ (Finset.range N).filter (fun i => exceptional i = true), B := by
      apply Finset.sum_le_sum
      intro i hi
      exact hbound i (Finset.mem_range.mp (Finset.mem_filter.mp hi).1)
    _ = exceptionalRoundCount exceptional N * B := by
      simp [exceptionalRoundCount]

/-- Normalized exceptional information is bounded by the exceptional fraction
scale times the uniform information bound. -/
theorem norm_normalized_exceptionalRoundInformation_le
    (exceptional : Nat -> Bool) (information : Nat -> E)
    (B : Real) (N : Nat)
    (hbound : ∀ i, i < N -> ‖information i‖ <= B) :
    ‖normalizedProtocolInformation
        (exceptionalRoundInformation exceptional information) N‖ <=
      exceptionalNormalizationWeight exceptional N * B := by
  change ‖(N : Real)⁻¹ •
      (∑ i ∈ Finset.range N, exceptionalRoundInformation exceptional information i)‖ <=
    exceptionalNormalizationWeight exceptional N * B
  calc
    ‖(N : Real)⁻¹ •
        (∑ i ∈ Finset.range N, exceptionalRoundInformation exceptional information i)‖ =
        ‖(N : Real)⁻¹‖ *
          ‖∑ i ∈ Finset.range N, exceptionalRoundInformation exceptional information i‖ :=
      norm_smul _ _
    _ <= ‖(N : Real)⁻¹‖ * (exceptionalRoundCount exceptional N * B) :=
      mul_le_mul_of_nonneg_left
        (norm_exceptionalRoundInformation_sum_le exceptional information B N hbound)
        (norm_nonneg _)
    _ = exceptionalNormalizationWeight exceptional N * B := by
      simp [exceptionalNormalizationWeight, mul_assoc]

/-- Sublinear exceptional normalization and a uniform primitive per-round bound
force the normalized exceptional information to vanish. -/
theorem normalizedExceptionalRoundInformation_tendsto_zero
    (exceptional : Nat -> Bool) (information : Nat -> E) (B : Real)
    (hB : 0 <= B)
    (hbound : ∀ i, ‖information i‖ <= B)
    (hweight : Tendsto (exceptionalNormalizationWeight exceptional) atTop (nhds 0)) :
    Tendsto
      (fun N => normalizedProtocolInformation
        (exceptionalRoundInformation exceptional information) N)
      atTop (nhds 0) := by
  rw [Metric.tendsto_nhds]
  intro epsilon hepsilon
  have hscalar : Tendsto
      (fun N => exceptionalNormalizationWeight exceptional N * B)
      atTop (nhds (0 * B)) := hweight.mul_const B
  rw [Metric.tendsto_nhds] at hscalar
  filter_upwards [hscalar epsilon hepsilon] with N hN
  rw [dist_zero_right]
  apply lt_of_le_of_lt
    (norm_normalized_exceptionalRoundInformation_le exceptional information B N
      (fun i hi => hbound i))
  have hweight_nonneg : 0 <= exceptionalNormalizationWeight exceptional N := by
    exact mul_nonneg (norm_nonneg _) (Nat.cast_nonneg _)
  simpa [Real.dist_eq, abs_of_nonneg hweight_nonneg, abs_of_nonneg hB] using hN

end ExceptionalBounds

/-! ## Deterministic and almost-sure limit composition -/

section LimitComposition

variable {E : Type u} [NormedAddCommGroup E] [NormedSpace Real E]

/-- Exploitation convergence plus negligible exploration and martingale
innovation implies realized-information convergence. -/
theorem normalizedProtocolInformation_tendsto_of_components
    (realized predictable : Nat -> E) (epsilon : Nat -> Real)
    (exploitation exploration : Nat -> E) (target : E)
    (hround : ∀ i,
      predictable i = predictableMixtureInformation epsilon exploitation exploration i)
    (hexploitation : Tendsto
      (fun N => normalizedProtocolInformation
        (exploitationInformation epsilon exploitation) N)
      atTop (nhds target))
    (hexploration : Tendsto
      (fun N => normalizedProtocolInformation
        (explorationInformation epsilon exploration) N)
      atTop (nhds 0))
    (hinnovation : Tendsto
      (fun N => normalizedProtocolInformation
        (informationInnovation realized predictable) N)
      atTop (nhds 0)) :
    Tendsto (fun N => normalizedProtocolInformation realized N)
      atTop (nhds target) := by
  have hsum := (hexploitation.add hexploration).add hinnovation
  simp only [add_zero] at hsum
  apply hsum.congr'
  filter_upwards [] with N
  simpa using
    (normalizedProtocolInformation_full_decomposition realized predictable epsilon
      exploitation exploration hround N).symm

/-- Regular-round convergence and sublinear bounded exceptional information
imply full-information convergence. -/
theorem normalizedProtocolInformation_tendsto_of_regular_and_exceptional
    (exceptional : Nat -> Bool) (information : Nat -> E) (target : E) (B : Real)
    (hB : 0 <= B)
    (hbound : ∀ i, ‖information i‖ <= B)
    (hweight : Tendsto (exceptionalNormalizationWeight exceptional) atTop (nhds 0))
    (hregular : Tendsto
      (fun N => normalizedProtocolInformation
        (regularRoundInformation exceptional information) N)
      atTop (nhds target)) :
    Tendsto (fun N => normalizedProtocolInformation information N)
      atTop (nhds target) := by
  have hexceptional := normalizedExceptionalRoundInformation_tendsto_zero
    exceptional information B hB hbound hweight
  have hsum := hregular.add hexceptional
  simp only [add_zero] at hsum
  apply hsum.congr'
  filter_upwards [] with N
  simpa using
    (normalizedProtocolInformation_regular_exceptional exceptional information N).symm

variable {Omega : Type v} [MeasurableSpace Omega]

/-- Almost-sure version of the full protocol-information composition theorem.
The hypotheses are component limits, not the final realized limit. -/
theorem ae_normalizedProtocolInformation_tendsto_of_components
    (mu : Measure Omega)
    (realized predictable : Omega -> Nat -> E)
    (epsilon : Nat -> Real)
    (exploitation exploration : Omega -> Nat -> E) (target : E)
    (hround : ∀ omega i,
      predictable omega i =
        predictableMixtureInformation epsilon (exploitation omega) (exploration omega) i)
    (hexploitation : ∀ᵐ omega ∂mu, Tendsto
      (fun N => normalizedProtocolInformation
        (exploitationInformation epsilon (exploitation omega)) N)
      atTop (nhds target))
    (hexploration : ∀ᵐ omega ∂mu, Tendsto
      (fun N => normalizedProtocolInformation
        (explorationInformation epsilon (exploration omega)) N)
      atTop (nhds 0))
    (hinnovation : ∀ᵐ omega ∂mu, Tendsto
      (fun N => normalizedProtocolInformation
        (informationInnovation (realized omega) (predictable omega)) N)
      atTop (nhds 0)) :
    ∀ᵐ omega ∂mu,
      Tendsto (fun N => normalizedProtocolInformation (realized omega) N)
        atTop (nhds target) := by
  filter_upwards [hexploitation, hexploration, hinnovation] with omega he hp hi
  exact normalizedProtocolInformation_tendsto_of_components
    (realized omega) (predictable omega) epsilon
    (exploitation omega) (exploration omega) target (hround omega) he hp hi

end LimitComposition

/-! ## Manuscript-facing compatibility labels -/

namespace Label

/-- Compatibility endpoint for requested main label `eq:mixed_info_decomposition`.
It is the exact finite mixed realized/predictable/innovation identity. -/
theorem eq_mixed_info_decomposition
    (realized predictable : Nat -> OracleMatrix) (N : Nat) :
    normalizedProtocolInformation realized N =
      normalizedProtocolInformation predictable N +
        normalizedProtocolInformation
          (informationInnovation realized predictable) N :=
  normalizedProtocolInformation_realized_decomposition realized predictable N

/-- Compatibility endpoint for requested main label `eq:r1_info_decomposition`. -/
theorem eq_r1_info_decomposition {n : Nat}
    (realized predictable : Nat -> Matrix (QubitOracle.TangentIndex n)
      (QubitOracle.TangentIndex n) Real) (N : Nat) :
    normalizedProtocolInformation realized N =
      normalizedProtocolInformation predictable N +
        normalizedProtocolInformation
          (informationInnovation realized predictable) N :=
  normalizedProtocolInformation_realized_decomposition realized predictable N

/-- Compatibility endpoint for requested supplement label
`eq:SI_mixed_information_decomposition`: martingale innovation plus the exact
exploration/exploitation mixture. -/
theorem eq_SI_mixed_information_decomposition
    (realized predictable : Nat -> OracleMatrix) (epsilon : Nat -> Real)
    (exploitation exploration : Nat -> OracleMatrix)
    (hround : ∀ i,
      predictable i = predictableMixtureInformation epsilon exploitation exploration i)
    (N : Nat) :
    normalizedProtocolInformation realized N =
      (normalizedProtocolInformation
          (exploitationInformation epsilon exploitation) N +
        normalizedProtocolInformation
          (explorationInformation epsilon exploration) N) +
        normalizedProtocolInformation
          (informationInnovation realized predictable) N :=
  normalizedProtocolInformation_full_decomposition realized predictable epsilon
    exploitation exploration hround N

/-- Compatibility endpoint for requested supplement label
`eq:SI_r1_information_decomposition`. -/
theorem eq_SI_r1_information_decomposition {n : Nat}
    (realized predictable : Nat -> Matrix (QubitOracle.TangentIndex n)
      (QubitOracle.TangentIndex n) Real)
    (epsilon : Nat -> Real)
    (exploitation exploration : Nat -> Matrix (QubitOracle.TangentIndex n)
      (QubitOracle.TangentIndex n) Real)
    (hround : ∀ i,
      predictable i = predictableMixtureInformation epsilon exploitation exploration i)
    (N : Nat) :
    normalizedProtocolInformation realized N =
      (normalizedProtocolInformation
          (exploitationInformation epsilon exploitation) N +
        normalizedProtocolInformation
          (explorationInformation epsilon exploration) N) +
        normalizedProtocolInformation
          (informationInnovation realized predictable) N :=
  normalizedProtocolInformation_full_decomposition realized predictable epsilon
    exploitation exploration hround N

/-- Current supplement equation `eq:SI_info_martingale`, expressed as its
exact defining identity. -/
theorem eq_SI_info_martingale_composition_identity
    {E : Type u} [AddCommGroup E]
    (realized predictable : Nat -> E) (i : Nat) :
    realized i = predictable i + informationInnovation realized predictable i := by
  simp [informationInnovation]

/-- Current supplement equation `eq:SI_predictable_decompose`, with the mixed
stage information allowed to be any already-constructed per-stage matrix. -/
theorem eq_SI_predictable_decompose_composition_identity
    (epsilon : Nat -> Real)
    (exploitation exploration : Nat -> OracleMatrix) (i : Nat) :
    predictableMixtureInformation epsilon exploitation exploration i =
      (1 - epsilon i) • exploitation i + epsilon i • exploration i :=
  rfl

/-- Exact exceptional-round comparison used before applying LAN or an
information limit. -/
theorem eq_exceptional_round_information_comparison
    {E : Type u} [AddCommGroup E] [Module Real E]
    (exceptional : Nat -> Bool) (information : Nat -> E) (N : Nat) :
    normalizedProtocolInformation information N =
      normalizedProtocolInformation
          (regularRoundInformation exceptional information) N +
        normalizedProtocolInformation
          (exceptionalRoundInformation exceptional information) N :=
  normalizedProtocolInformation_regular_exceptional exceptional information N

/-- Exact stage/block sum identity at completed batch endpoint `K`. -/
theorem eq_protocol_information_stage_block_sum
    {E : Type u} [AddCommMonoid E]
    (information : Nat -> E) (blockSize : Nat -> Nat) (K : Nat) :
    (∑ i ∈ Finset.range (cumulativeProtocolLength blockSize K), information i) =
      ∑ k ∈ Finset.range K,
        protocolInformationBlock information
          (cumulativeProtocolLength blockSize k) (blockSize k) :=
  accumulatedProtocolInformation_eq_sum_blocks information blockSize K

/-- The exact current mixed accumulated-information definition is reused from
`CanonicalResolvedLabels`; this theorem records that it is the common generic
empirical-information object. -/
theorem eq_accumulated_mixed_info_composes_with_generic_average
    {Theta M Y : Type*} [Fintype Y]
    (model : FiniteScoreModel Theta M Y (Fin 3)) (theta : Theta)
    (history : SequentialHistory M Y) :
    eq_accumulated_mixed_info model theta history =
      empiricalInformation model theta history :=
  rfl

/-- Rank-one analogue of the preceding exact definitional bridge. -/
theorem eq_accumulated_r1_info_composes_with_generic_average
    {Theta M Y : Type*} [Fintype Y] {n : Nat}
    (model : FiniteScoreModel Theta M Y (QubitOracle.TangentIndex n))
    (theta : Theta) (history : SequentialHistory M Y) :
    eq_accumulated_r1_info model theta history =
      empiricalInformation model theta history :=
  rfl

end Label

end

