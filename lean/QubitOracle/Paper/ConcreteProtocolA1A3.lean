noncomputable section

local instance : MeasurableSpace BinaryOutcome := ⊤

/-! ## Structural (A1) facts -/

/-- The mixed protocol chooses a Bloch measurement axis of norm at most one. -/
abbrev MixedMeasurementAxis :=
  {u : Fin 3 -> Real // QubitOracle.blochNormSq u <= 1}

/-- The design rule is parameter-free precisely because its type has no state
parameter argument. -/
def ParameterFreeDesign
    {Theta Action Outcome : Type*}
    [MeasurableSpace Action] [MeasurableSpace Outcome]
    (protocol : PredictableAdaptiveProtocol Theta Action Outcome) : Prop :=
  Exists fun design : Nat -> AdaptiveTrajectory Outcome -> Action =>
    protocol.design = design

/-- Parameter independence is unconditional for every
`PredictableAdaptiveProtocol`. -/
theorem protocol_parameterFreeDesign
    {Theta Action Outcome : Type*}
    [MeasurableSpace Action] [MeasurableSpace Outcome]
    (protocol : PredictableAdaptiveProtocol Theta Action Outcome) :
    ParameterFreeDesign protocol :=
  ⟨protocol.design, rfl⟩

/-- The one-step conditional response law generated by the trajectory kernel. -/
def HasConditionalResponseLaw
    {Theta Action Outcome : Type*}
    [MeasurableSpace Action] [MeasurableSpace Outcome]
    (protocol : PredictableAdaptiveProtocol Theta Action Outcome) : Prop :=
  forall theta n history,
    adaptiveStepKernel protocol theta n history =
      protocol.response theta (protocol.design n history)

/-- The conditional response identity is unconditional from the kernel
construction. -/
theorem protocol_hasConditionalResponseLaw
    {Theta Action Outcome : Type*}
    [MeasurableSpace Action] [MeasurableSpace Outcome]
    (protocol : PredictableAdaptiveProtocol Theta Action Outcome) :
    HasConditionalResponseLaw protocol := by
  intro theta n history
  exact adaptiveStepKernel_apply protocol theta n history

/-- A proof-only regular-round indicator is predictable when it is measurable
from the history available before the next outcome. -/
def PredictableRegularIndicator
    {Outcome : Type*} [MeasurableSpace Outcome]
    (regular : Nat -> AdaptiveTrajectory Outcome -> Bool) : Prop :=
  forall n, Measurable (regular n)

/-- Mixed-qubit rounds are all regular. -/
def allRoundsRegular
    {Outcome : Type*} [MeasurableSpace Outcome] :
    Nat -> AdaptiveTrajectory Outcome -> Bool :=
  fun _ _ => true

/-- The all-regular indicator is predictably measurable. -/
theorem allRoundsRegular_predictable
    {Outcome : Type*} [MeasurableSpace Outcome] :
    PredictableRegularIndicator (allRoundsRegular (Outcome := Outcome)) := by
  intro n
  exact measurable_const

/-- Exact binary Born response law for the mixed-qubit protocol. -/
def MixedBinaryBornResponseLaw
    (protocol : PredictableAdaptiveProtocol
      (Fin 3 -> Real) MixedMeasurementAxis BinaryOutcome) : Prop :=
  forall theta axis outcome,
    ((protocol.response theta) axis) {outcome} =
      ENNReal.ofReal
        (binaryBornProbability (QubitOracle.blochDot theta axis.1) outcome)

/-- A finite-outcome Born law interface for the rank-one protocol.  The
function `bornMass` is where the state/POVM trace formula is instantiated. -/
def FiniteBornResponseLaw
    {Theta Action Outcome : Type*}
    [MeasurableSpace Action] [MeasurableSpace Outcome]
    (protocol : PredictableAdaptiveProtocol Theta Action Outcome)
    (bornMass : Theta -> Action -> Outcome -> Real) : Prop :=
  forall theta action outcome,
    ((protocol.response theta) action) {outcome} =
      ENNReal.ofReal (bornMass theta action outcome)



/-! ## Primitive martingale and information bridges for (A2) -/

/-- The martingale-difference hypothesis split into its three mathematical
components, rather than assumed as the final conjunction consumed by the CLT. -/
structure MartingaleDifferencePrimitives
    {D : Type*} [Fintype D]
    (problem : MartingaleCLTProblem D) : Prop where
  partialSum_martingale :
    forall u n,
      Martingale
        (martingaleArrayPartialSum (problem.projectedIncrement u) n)
        (problem.filtration n) problem.mu
  projectedIncrement_memLp :
    forall u n k, MemLp (problem.projectedIncrement u n k) 2 problem.mu
  filtration_mono :
    forall n k, (problem.filtration n : Nat -> MeasurableSpace problem.Omega) k <=
      (problem.filtration (n + 1) : Nat -> MeasurableSpace problem.Omega) k

/-- Assemble the exact martingale-difference-array condition used by
Hall--Heyde. -/
theorem MartingaleDifferencePrimitives.toMartingaleDifferenceArray
    {D : Type*} [Fintype D]
    {problem : MartingaleCLTProblem D}
    (h : MartingaleDifferencePrimitives problem) :
    problem.IsSquareIntegrableMartingaleDifferenceArray :=
  ⟨h.partialSum_martingale, h.projectedIncrement_memLp, h.filtration_mono⟩

/-- The precise residual bridge from bounded finite-outcome scores to the
Hall--Heyde conditional Lindeberg expression.  Existing mixed-score lemmas
prove the finite tail sum is eventually zero; an application must identify
that finite tail sum with this conditional expression. -/
structure BoundedScoreLindebergPrimitives
    {D : Type*} [Fintype D]
    (problem : MartingaleCLTProblem D) : Prop where
  conditionalTail_eventually_zero :
    letI : MeasurableSpace problem.Omega := problem.measurableSpace
    forall u epsilon, 0 < epsilon ->
      ∀ᶠ n in atTop,
        forall omega,
          hallHeydeArrayConditionalLindeberg problem.mu problem.filtration
              (problem.projectedIncrement u) epsilon n omega = 0

/-- Eventual vanishing of every conditional tail gives Hall--Heyde's
conditional Lindeberg condition. -/
theorem BoundedScoreLindebergPrimitives.toConditionalLindeberg
    {D : Type*} [Fintype D]
    {problem : MartingaleCLTProblem D}
    (h : BoundedScoreLindebergPrimitives problem) :
    problem.HasConditionalLindeberg := by
  letI : MeasurableSpace problem.Omega := problem.measurableSpace
  intro u epsilon hepsilon
  apply tendstoInMeasure_of_eventually_uniform_norm_le
    problem.mu
    (hallHeydeArrayConditionalLindeberg problem.mu problem.filtration
      (problem.projectedIncrement u) epsilon)
    (fun _ => 0) tendsto_const_nhds
  filter_upwards [h.conditionalTail_eventually_zero u epsilon hepsilon] with n hn
  intro omega
  simp [hn omega]



