import QubitOracle.Paper.OneQubitMixedExactCycleCLTConditions
import Mathlib.Probability.Process.Filtration

/-!
# Finite-row filtration bridge for the exact-cycle mixed-qubit score

Fix one finite row of the scalar exact-cycle array.  Time zero reveals the
complete pilot.  At time `k`, the filtration additionally reveals final
outcomes with index strictly below `k`.  The sigma algebra is the comap of an
explicit masked-prefix projection into a discrete history type, so filtration
monotonicity is proved by factorization of prefix projections.

The conditional score, square, and Lindeberg identities are certified by an
exact finite Born-kernel characterization.  No regular conditional
probability theorem is used.  The final conversion from this finite
characterization to Mathlib's `condExp` set-integral API is isolated as the
named residual proposition `MixedExactCycleMathlibCondExpAPIBridge`.
-/

open scoped BigOperators ENNReal

namespace QubitOracle.Paper

open Filter MeasureTheory Set

noncomputable section

namespace MixedExactCycleScalarTriangularArrayData

/-! ## Explicit finite probability mass and prefix filtration -/

/-- A finite probability measure represented atom-by-atom. -/
structure ExactFiniteProbabilityMass (Omega : Type*) [Fintype Omega] where
  atomMass : Omega -> ℝ
  atomMass_nonnegative : ∀ omega, 0 ≤ atomMass omega
  atomMass_sum_one : (∑ omega, atomMass omega) = 1

/-- The explicit joint two-stage probability mass on one fixed row. -/
def rowProbabilityMass
    (A : MixedExactCycleScalarTriangularArrayData) (r : ℕ) :
    ExactFiniteProbabilityMass (A.RowSpace r) where
  atomMass := A.jointRowMass r
  atomMass_nonnegative := A.jointRowMass_nonnegative r
  atomMass_sum_one := A.jointRowMass_sum_one r

/-- A masked path records revealed outcomes as `some outcome` and hides all
other coordinates as `none`. -/
def revealedFinalPrefix
    (A : MixedExactCycleScalarTriangularArrayData)
    (r k : ℕ) (finalPath : A.FinalSpace r) :
    Fin (3 * r) -> Option Bool :=
  fun i => if i.1 < k then some (finalPath i) else none

/-- History key at time `k`: the full pilot and the masked final prefix. -/
abbrev HistoryKey
    (A : MixedExactCycleScalarTriangularArrayData) (r : ℕ) :=
  A.PilotSpace r × (Fin (3 * r) -> Option Bool)

/-- Projection generating the time-`k` sigma algebra. -/
def historyProjection
    (A : MixedExactCycleScalarTriangularArrayData)
    (r k : ℕ) (row : A.RowSpace r) : A.HistoryKey r :=
  (row.1, A.revealedFinalPrefix r k row.2)

/-- Truncate any revealed history back to time `k`. -/
def truncateHistory
    (A : MixedExactCycleScalarTriangularArrayData)
    (r k : ℕ) (history : A.HistoryKey r) : A.HistoryKey r :=
  (history.1, fun i => if i.1 < k then history.2 i else none)

/-- The concrete time-`k` sigma algebra is generated by the prefix
projection. -/
def rowFiltrationSigma
    (A : MixedExactCycleScalarTriangularArrayData)
    (r k : ℕ) : MeasurableSpace (A.RowSpace r) :=
  MeasurableSpace.comap (A.historyProjection r k) ⊤

/-- At time zero the masked final history is empty, so only the complete
pilot is revealed. -/
theorem historyProjection_zero
    (A : MixedExactCycleScalarTriangularArrayData)
    (r : ℕ) (row : A.RowSpace r) :
    A.historyProjection r 0 row =
      (row.1, fun _i : Fin (3 * r) => none) := by
  apply Prod.ext
  · rfl
  · funext i
    simp [historyProjection, revealedFinalPrefix]

/-- Earlier masked prefixes factor through later masked prefixes. -/
theorem historyProjection_factor
    (A : MixedExactCycleScalarTriangularArrayData)
    (r k l : ℕ) (hkl : k ≤ l) :
    A.historyProjection r k =
      A.truncateHistory r k ∘ A.historyProjection r l := by
  funext row
  apply Prod.ext
  · rfl
  · funext i
    by_cases hik : i.1 < k
    · have hil : i.1 < l := lt_of_lt_of_le hik hkl
      simp [historyProjection, truncateHistory, revealedFinalPrefix,
        hik, hil]
    · simp [historyProjection, truncateHistory, revealedFinalPrefix, hik]

/-- The prefix-comap sigma algebras are monotone. -/
theorem rowFiltrationSigma_mono
    (A : MixedExactCycleScalarTriangularArrayData) (r : ℕ) :
    Monotone (A.rowFiltrationSigma r) := by
  intro k l hkl
  unfold rowFiltrationSigma
  rw [A.historyProjection_factor r k l hkl]
  rw [← MeasurableSpace.comap_comp]
  exact MeasurableSpace.comap_mono le_top

/-- The actual discrete filtration on one fixed finite row.  It is viewed as
a filtration of the full discrete row sigma algebra. -/
def rowFiltration
    (A : MixedExactCycleScalarTriangularArrayData) (r : ℕ) :
    Filtration ℕ (⊤ : MeasurableSpace (A.RowSpace r)) where
  seq := A.rowFiltrationSigma r
  mono' := A.rowFiltrationSigma_mono r
  le' := fun _k => le_top

@[simp]
theorem rowFiltration_apply
    (A : MixedExactCycleScalarTriangularArrayData) (r k : ℕ) :
    A.rowFiltration r k = A.rowFiltrationSigma r k :=
  rfl

/-! ## Adapted score increments -/

/-- Read the time-`t` score from a history which has revealed outcome `t`.
The `none` branch is irrelevant at time `t+1` but makes the function total. -/
def scoreIncrementFromHistory
    (A : MixedExactCycleScalarTriangularArrayData)
    (r : ℕ) (t : Fin (3 * r)) (history : A.HistoryKey r) : ℝ :=
  match history.2 t with
  | some outcome => A.normalizedFinalScoreIncrement r history.1 t outcome
  | none => 0

/-- The row score increment factors through the time-`t+1` history
projection. -/
theorem rowScoreIncrement_factor_history_succ
    (A : MixedExactCycleScalarTriangularArrayData)
    (r : ℕ) (t : Fin (3 * r)) :
    (fun row : A.RowSpace r =>
      A.rowNormalizedFinalScoreIncrement r row t) =
      A.scoreIncrementFromHistory r t ∘
        A.historyProjection r (t.1 + 1) := by
  funext row
  simp [rowNormalizedFinalScoreIncrement, scoreIncrementFromHistory,
    historyProjection, revealedFinalPrefix, Nat.lt_succ_self]

/-- Item 1: the time-`t` score increment is measurable at time `t+1`, hence
adapted to the concrete prefix filtration. -/
theorem rowScoreIncrement_measurable_succ
    (A : MixedExactCycleScalarTriangularArrayData)
    (r : ℕ) (t : Fin (3 * r)) :
    @Measurable (A.RowSpace r) ℝ
      (A.rowFiltrationSigma r (t.1 + 1))
      (inferInstance : MeasurableSpace ℝ)
      (fun row => A.rowNormalizedFinalScoreIncrement r row t) := by
  rw [A.rowScoreIncrement_factor_history_succ r t]
  have hprojection :
      @Measurable (A.RowSpace r) (A.HistoryKey r)
        (A.rowFiltrationSigma r (t.1 + 1)) ⊤
        (A.historyProjection r (t.1 + 1)) := by
    exact measurable_iff_comap_le.mpr le_rfl
  have hread :
      @Measurable (A.HistoryKey r) ℝ ⊤
        (inferInstance : MeasurableSpace ℝ)
        (A.scoreIncrementFromHistory r t) := by
    intro _set _hset
    simp
  exact hread.comp hprojection

/-! ## Exact finite conditional-expectation characterization -/

/-- Exact one-step finite-product characterization of a conditional
expectation at time `t`.

`observable pilot outcome` is evaluated at the current binary coordinate.
The candidate must be invariant on time-`t` prefix atoms and must equal the
explicit one-step Born average.  For a finite product law these are precisely
the atomwise conditional-expectation data; conversion to Mathlib's
set-integral/`condExp` representation is isolated below. -/
structure ExactFiniteStepConditionalExpectation
    (A : MixedExactCycleScalarTriangularArrayData)
    (r : ℕ) (t : Fin (3 * r))
    (observable : A.PilotSpace r -> Bool -> ℝ)
    (candidate : A.RowSpace r -> ℝ) : Prop where
  prefixInvariant :
    ∀ row₁ row₂ : A.RowSpace r,
      A.historyProjection r t.1 row₁ =
        A.historyProjection r t.1 row₂ ->
      candidate row₁ = candidate row₂
  bornKernelIdentity :
    ∀ row : A.RowSpace r,
      candidate row =
        ∑ outcome : Bool,
          mixedTwoStageFinalBornProbability
              A.theta (A.selected r) row.1 t outcome *
            observable row.1 outcome

/-- Canonical current-coordinate random variable associated with an
observable in the finite conditional-expectation characterization. -/
def currentCoordinateObservable
    (A : MixedExactCycleScalarTriangularArrayData)
    (r : ℕ) (t : Fin (3 * r))
    (observable : A.PilotSpace r -> Bool -> ℝ)
    (row : A.RowSpace r) : ℝ :=
  observable row.1 (row.2 t)

/-- The normalized score as a one-coordinate observable. -/
def scoreObservable
    (A : MixedExactCycleScalarTriangularArrayData)
    (r : ℕ) (t : Fin (3 * r))
    (pilot : A.PilotSpace r) (outcome : Bool) : ℝ :=
  A.normalizedFinalScoreIncrement r pilot t outcome

/-- Item 2: exact finite conditional-expectation certificate saying that the
row score increment has conditional expectation zero at time `t`. -/
theorem scoreIncrement_finiteConditionalExpectation_zero
    (A : MixedExactCycleScalarTriangularArrayData)
    (r : ℕ) (t : Fin (3 * r)) :
    ExactFiniteStepConditionalExpectation A r t
      (A.scoreObservable r t) (fun _row => 0) := by
  refine ⟨?_, ?_⟩
  · intro row₁ row₂ _hhistory
    rfl
  · intro row
    symm
    simpa [scoreObservable] using
      (A.conditionalScoreCentering r row.1 t)

/-- One-shot Fisher kernel as a row function.  It depends only on the pilot
and is therefore time-zero, hence time-`t`, measurable. -/
def oneShotFisherKernel
    (A : MixedExactCycleScalarTriangularArrayData)
    (r : ℕ) (t : Fin (3 * r)) (row : A.RowSpace r) : ℝ :=
  mixedExactCycleOneShotNormalizedDirectionalFisher
    A.theta A.direction (A.selected r) row.1 t

/-- Squared normalized score as a one-coordinate observable. -/
def squaredScoreObservable
    (A : MixedExactCycleScalarTriangularArrayData)
    (r : ℕ) (t : Fin (3 * r))
    (pilot : A.PilotSpace r) (outcome : Bool) : ℝ :=
  A.normalizedFinalScoreIncrement r pilot t outcome ^ 2

/-- Item 3: exact finite conditional squared-expectation certificate. -/
theorem squaredScore_finiteConditionalExpectation_eq_oneShotFisher
    (A : MixedExactCycleScalarTriangularArrayData)
    (r : ℕ) (hr : 0 < r) (t : Fin (3 * r)) :
    ExactFiniteStepConditionalExpectation A r t
      (A.squaredScoreObservable r t)
      (A.oneShotFisherKernel r t) := by
  refine ⟨?_, ?_⟩
  · intro row₁ row₂ hhistory
    have hpilot : row₁.1 = row₂.1 :=
      congrArg (fun history : A.HistoryKey r => history.1) hhistory
    simp [oneShotFisherKernel, hpilot]
  · intro row
    unfold oneShotFisherKernel squaredScoreObservable
    symm
    simpa [normalizedFinalScoreIncrement] using
      (mixedExactCycleFinalShotNormalizedSquare_bornExpectation_eq_fisher
        A.theta A.direction (A.selected r) row.1 t A.interior hr)

/-! ## Predictable quadratic variation -/

/-- Formal predictable quadratic variation obtained by summing the exact
one-shot conditional squared-score kernels. -/
def predictableQuadraticVariation
    (A : MixedExactCycleScalarTriangularArrayData)
    (r : ℕ) (row : A.RowSpace r) : ℝ :=
  ∑ t : Fin (3 * r), A.oneShotFisherKernel r t row

/-- Item 4: the formal predictable quadratic variation is exactly the
explicit normalized Fisher expression. -/
theorem predictableQuadraticVariation_eq_explicitNormalizedFisher
    (A : MixedExactCycleScalarTriangularArrayData)
    (r : ℕ) (row : A.RowSpace r) :
    A.predictableQuadraticVariation r row =
      A.explicitNormalizedFisher r row.1 := by
  rfl

/-- The conditional variance sum from the CLT-condition module is the same
predictable quadratic variation, evaluated on the completed pilot. -/
theorem conditionalVariance_eq_predictableQuadraticVariation
    (A : MixedExactCycleScalarTriangularArrayData)
    (r : ℕ) (hr : 0 < r) (row : A.RowSpace r) :
    A.conditionalVariance r row.1 =
      A.predictableQuadraticVariation r row := by
  rw [A.conditionalVariance_eq_explicitNormalizedFisher r hr row.1,
    A.predictableQuadraticVariation_eq_explicitNormalizedFisher r row]

/-! ## Conditional Lindeberg expression -/

/-- Truncated squared increment as a current-coordinate observable. -/
def lindebergObservable
    (A : MixedExactCycleScalarTriangularArrayData)
    (r : ℕ) (t : Fin (3 * r)) (epsilon : ℝ)
    (pilot : A.PilotSpace r) (outcome : Bool) : ℝ :=
  if epsilon ≤ |A.normalizedFinalScoreIncrement r pilot t outcome| then
    A.normalizedFinalScoreIncrement r pilot t outcome ^ 2
  else 0

/-- One-shot conditional Lindeberg kernel. -/
def oneShotLindebergKernel
    (A : MixedExactCycleScalarTriangularArrayData)
    (r : ℕ) (t : Fin (3 * r)) (epsilon : ℝ)
    (row : A.RowSpace r) : ℝ :=
  ∑ outcome : Bool,
    mixedTwoStageFinalBornProbability
        A.theta (A.selected r) row.1 t outcome *
      A.lindebergObservable r t epsilon row.1 outcome

/-- Exact finite conditional-expectation certificate for every one-shot
Lindeberg truncation. -/
theorem lindeberg_finiteConditionalExpectation_eq_kernel
    (A : MixedExactCycleScalarTriangularArrayData)
    (r : ℕ) (t : Fin (3 * r)) (epsilon : ℝ) :
    ExactFiniteStepConditionalExpectation A r t
      (A.lindebergObservable r t epsilon)
      (A.oneShotLindebergKernel r t epsilon) := by
  refine ⟨?_, ?_⟩
  · intro row₁ row₂ hhistory
    have hpilot : row₁.1 = row₂.1 :=
      congrArg (fun history : A.HistoryKey r => history.1) hhistory
    simp [oneShotLindebergKernel, hpilot]
  · intro row
    rfl

/-- Sum of the one-shot conditional Lindeberg kernels. -/
def predictableLindebergExpression
    (A : MixedExactCycleScalarTriangularArrayData)
    (r : ℕ) (epsilon : ℝ) (row : A.RowSpace r) : ℝ :=
  ∑ t : Fin (3 * r), A.oneShotLindebergKernel r t epsilon row

/-- Item 5: the filtration-level finite conditional Lindeberg expression is
exactly the previously defined conditional Lindeberg sum. -/
theorem predictableLindebergExpression_eq_conditionalLindebergSum
    (A : MixedExactCycleScalarTriangularArrayData)
    (r : ℕ) (epsilon : ℝ) (row : A.RowSpace r) :
    A.predictableLindebergExpression r epsilon row =
      A.conditionalLindebergSum r row.1 epsilon := by
  unfold predictableLindebergExpression oneShotLindebergKernel
    lindebergObservable conditionalLindebergSum
  apply Finset.sum_congr rfl
  intro t _ht
  apply Finset.sum_congr rfl
  intro outcome _houtcome
  by_cases htail : epsilon ≤
      |A.normalizedFinalScoreIncrement r row.1 t outcome|
  · simp [htail]
  · simp [htail]

/-! ## Named residual Mathlib API bridge -/

/-- Atomwise integral identity associated with the prefix partition.  This is
the finite statement consumed by Mathlib's
`condExp_ae_eq_of_forall_setIntegral_eq` characterization. -/
def PrefixAtomIntegralIdentity
    (A : MixedExactCycleScalarTriangularArrayData)
    (r : ℕ) (t : Fin (3 * r))
    (randomVariable candidate : A.RowSpace r -> ℝ) : Prop :=
  ∀ baseRow : A.RowSpace r,
    (∑ row : A.RowSpace r,
      if A.historyProjection r t.1 row =
          A.historyProjection r t.1 baseRow then
        A.jointRowMass r row * candidate row
      else 0) =
    ∑ row : A.RowSpace r,
      if A.historyProjection r t.1 row =
          A.historyProjection r t.1 baseRow then
        A.jointRowMass r row * randomVariable row
      else 0

/-- The sole residual API bridge.

It states that every exact one-step finite Born-kernel certificate yields the
prefix-atom integral identity required to identify the candidate with
Mathlib's conditional expectation.  Proving this proposition amounts to a
generic finite-product/finite-partition lemma plus the final call to
`condExp_ae_eq_of_forall_setIntegral_eq`; no qubit-specific probability or
limit argument remains.  It is a definition of the outstanding proposition,
not an axiom and not assumed by any theorem in this file. -/
def MixedExactCycleMathlibCondExpAPIBridge
    (A : MixedExactCycleScalarTriangularArrayData) (r : ℕ) : Prop :=
  ∀ (t : Fin (3 * r))
    (observable : A.PilotSpace r -> Bool -> ℝ)
    (candidate : A.RowSpace r -> ℝ),
    ExactFiniteStepConditionalExpectation A r t observable candidate ->
      PrefixAtomIntegralIdentity A r t
        (A.currentCoordinateObservable r t observable) candidate

end MixedExactCycleScalarTriangularArrayData

end

